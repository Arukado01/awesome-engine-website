{
  "name": "awesome-engine-contact",
  "private": true,
  "version": "1.0.0",
  "description": "Secure contact endpoint for Awesome Engine",
  "main": "lib/index.js",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "lint": "eslint src test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "nodemailer": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/nodemailer": "8.0.2",
    "eslint": "10.14.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
