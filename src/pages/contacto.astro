---
import Base from '../layouts/Base.astro';
import { getLocale } from '../i18n/locales';

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const enabled = import.meta.env.PUBLIC_CONTACT_ENABLED === 'true' && Boolean(siteKey.trim());
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || '/api/contact';
---

<Base
  title="Contacto"
  description="Hablemos de Awesome Engine. Envía una pregunta, comparte una idea o reporta un problema del sitio."
>
  <section class="page-intro">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Inicio</a>
        <span>/</span>
        <span>Contacto</span>
      </div>
      <span class="eyebrow">ABRAMOS LA CONVERSACIÓN</span>
      <h1>
        Una idea empieza
        <br />
        con un mensaje.
      </h1>
      <p class="lead">
        Preguntas sobre el motor, propuestas o algo que podemos mejorar. Este es el lugar para
        hablarlo.
      </p>
    </div>
  </section>
  <section class="section container contact-layout">
    <div class="contact-info">
      <span class="eyebrow">HABLEMOS DE AWESOME ENGINE</span>
      <h2>
        De desarrollador
        <br />a desarrollador.
      </h2>
      <p>Tu mensaje llegará a Carlos Cortina, desarrollador de Awesome Engine.</p>
      <div class="contact-channel">
        <span>CORREO DE CONTACTO</span>
        <a href="mailto:carlosjcortinam@gmail.com">carlosjcortinam@gmail.com ↗</a>
      </div>
      <div class="contact-channel">
        <span>CÓDIGO Y CONTRIBUCIONES</span>
        <a href="https://github.com/Arukado01/AwesomeEngine">Awesome Engine en GitHub ↗</a>
      </div>
      <p class="privacy-note">
        Tus datos se usan para responder a esta conversación.{' '}
        <a href="/privacidad/">Consulta la información de privacidad.</a>
      </p>
    </div>
    <form id="contact-form" data-enabled={String(enabled)} data-endpoint={endpoint} novalidate>
      <h2 class="form-title">Escribe tu mensaje</h2>
      {!enabled && (
        <div class="contact-notice" role="status">
          <strong>El envío desde el formulario aún no está disponible.</strong>
          <span>
            Puedes escribir al correo de contacto. Publicaremos aquí la confirmación cuando el
            servicio esté habilitado.
          </span>
        </div>
      )}
      <div class="form-row">
        <div class="field">
          <label for="name">
            Nombre <span aria-hidden="true">*</span>
          </label>
          <input
            id="name"
            name="name"
            required
            minlength="2"
            maxlength="80"
            autocomplete="name"
            placeholder="Tu nombre"
            aria-describedby="name-error"
          />
          <span class="field-error" id="name-error"></span>
        </div>
        <div class="field">
          <label for="email">
            Correo electrónico <span aria-hidden="true">*</span>
          </label>
          <input
            id="email"
            name="email"
            type="email"
            required
            maxlength="254"
            autocomplete="email"
            placeholder="tu@correo.com"
            aria-describedby="email-error"
          />
          <span class="field-error" id="email-error"></span>
        </div>
      </div>
      <div class="field">
        <label for="subject">
          Asunto <span aria-hidden="true">*</span>
        </label>
        <input
          id="subject"
          name="subject"
          required
          minlength="3"
          maxlength="160"
          placeholder="¿Sobre qué quieres hablar?"
          aria-describedby="subject-error"
        />
        <span class="field-error" id="subject-error"></span>
      </div>
      <div class="field">
        <label for="message">
          Mensaje <span aria-hidden="true">*</span>
        </label>
        <textarea
          id="message"
          name="message"
          required
          minlength="20"
          maxlength="5000"
          rows="6"
          placeholder="Cuéntanos tu idea o pregunta…"
          aria-describedby="message-error message-count"
        ></textarea>
        <div class="message-meta">
          <span class="field-error" id="message-error"></span>
          <span id="message-count">0 / 5000</span>
        </div>
      </div>
      <div class="honeypot" aria-hidden="true">
        <label for="website">Deja este campo vacío</label>
        <input id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>
      {enabled && siteKey && (
        <div class="captcha-shell">
          <div id="captcha-loading" class="captcha-loading" role="status">
            <span class="skeleton"></span>
            <span>Preparando verificación de seguridad…</span>
          </div>
          <div
            class="cf-turnstile"
            data-sitekey={siteKey}
            data-action="contact"
            data-language={
              getLocale(Astro.url.pathname) === 'zh' ? 'zh-cn' : getLocale(Astro.url.pathname)
            }
            data-theme="auto"
            data-callback="aeCaptchaReady"
            data-error-callback="aeCaptchaError"
            data-expired-callback="aeCaptchaExpired"
          ></div>
          <p class="field-error" id="captcha-error" role="status"></p>
        </div>
      )}
      <p class="form-policy">
        Al enviar, aceptas que usemos estos datos para responderte. No se suscribirá tu correo a
        ninguna lista.
      </p>
      <p class="form-policy">Si es posible, recibirás una copia de tu mensaje por correo.</p>
      <button
        class="button primary submit-button"
        id="contact-submit"
        type="submit"
        disabled={!enabled}
      >
        <span>Enviar mensaje</span>
        <span aria-hidden="true">↗</span>
      </button>
      <div
        id="form-status"
        class="form-status"
        role="status"
        aria-live="polite"
        tabindex="-1"
        hidden
      ></div>
      <button id="contact-new-attempt" type="button" class="button secondary new-attempt" hidden>
        Iniciar otro envío
      </button>
      <noscript>
        <p class="contact-notice">
          Este formulario necesita JavaScript para validar y enviar tu mensaje de forma segura.
        </p>
      </noscript>
    </form>
  </section>

  <script>
    import '../scripts/contact';
  </script>
</Base>
<style>
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    align-items: start;
    gap: clamp(2.5rem, 1rem + 5vw, 6rem);
  }
  .contact-info h2 {
    margin-bottom: 1.5rem;
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.625rem);
  }
  .contact-info > p {
    max-width: 24rem;
    line-height: 1.75;
  }
  .contact-info > p + .contact-channel {
    margin-top: 1.75rem;
    border-top: 1px solid var(--border);
  }
  .contact-channel {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }
  .contact-channel > span {
    color: var(--muted);
    font: 500 var(--text-2xs) var(--font-mono);
    letter-spacing: 0.12em;
  }
  .contact-channel a {
    color: var(--accent);
    font-size: var(--text-md);
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .contact-channel a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .contact-info > .privacy-note {
    margin-top: 1.75rem;
    font-size: var(--text-sm);
  }
  .privacy-note a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  #contact-form {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--surface);
  }
  .form-title {
    margin-bottom: 1.5rem;
    font-size: var(--text-2xl);
  }
  .contact-notice {
    display: grid;
    gap: 0.375rem;
    margin-bottom: 1.5rem;
    padding: 1rem 1.125rem;
    border: 1px solid color-mix(in srgb, var(--warning) 45%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--warning) 7%, var(--surface));
    color: var(--text-soft);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .contact-notice strong {
    display: block;
    color: var(--text);
  }
  .form-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.25rem;
  }
  .field {
    margin-bottom: 1.25rem;
  }
  .field label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .field label span {
    color: var(--accent);
  }
  .field input,
  .field textarea {
    display: block;
    width: 100%;
    min-height: 2.875rem;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    font-size: var(--text-base);
    line-height: 1.5;
    resize: vertical;
    transition: border-color var(--transition);
  }
  .field input:hover,
  .field textarea:hover {
    border-color: var(--border-strong);
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline-offset: 1px;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--muted);
    opacity: 1;
  }
  .field input[aria-invalid='true'],
  .field textarea[aria-invalid='true'] {
    border-color: var(--danger);
  }
  .field-error {
    display: block;
    margin-top: 0.375rem;
    color: var(--danger);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .message-meta {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 1.25rem;
  }
  .message-meta > span:last-child {
    flex-shrink: 0;
    margin-top: 0.5rem;
    margin-left: auto;
    color: var(--muted);
    font: var(--text-xs) var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form-policy {
    max-width: 30rem;
    margin-bottom: 0.75rem;
    font-size: var(--text-sm);
    line-height: 1.65;
  }
  .form-policy + .form-policy {
    margin-bottom: 1.5rem;
  }
  .new-attempt {
    margin-top: 0.875rem;
  }
  .submit-button {
    min-width: 12.5rem;
    justify-content: space-between;
  }
  .form-status {
    margin-top: 1.25rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    font-size: var(--text-md);
  }
  .form-status.error {
    border-color: color-mix(in srgb, var(--danger) 60%, transparent);
    background: color-mix(in srgb, var(--danger) 7%, var(--surface));
    color: var(--danger);
  }
  .form-status.success {
    border-color: color-mix(in srgb, var(--mint) 55%, transparent);
    background: color-mix(in srgb, var(--mint) 7%, var(--surface));
    color: var(--mint);
  }
  .captcha-shell {
    min-height: 85px;
    margin-bottom: 1.25rem;
  }
  .captcha-loading {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .captcha-loading .skeleton {
    height: 55px;
    max-width: 300px;
  }
  @media (max-width: 900px) {
    .contact-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .contact-info > p {
      max-width: 36rem;
    }
  }
  @media (max-width: 640px) {
    .form-row {
      grid-template-columns: minmax(0, 1fr);
    }
    .submit-button {
      width: 100%;
    }
  }
</style>
