---
import Base from '../layouts/Base.astro';
import { getLocale, localeInfo } from '../i18n/locales';
const currentLocale = localeInfo[getLocale(Astro.url.pathname)].html;
import CategoryPicker from '../components/CategoryPicker.astro';
import { updates } from '../data/updates';
const categories = [...new Set(updates.map((u) => u.category))];
const date = (value: string) =>
  new Date(value).toLocaleDateString(currentLocale, {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    timeZone: 'America/Bogota',
  });
---

<Base
  title="Evolución y mejora continua"
  description="Un historial auténtico de Awesome Engine: cambios, mejoras, correcciones y desarrollo pendiente, con enlaces a cada commit."
>
  <section class="page-intro">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Inicio</a>
        <span>/</span>
        <span>Evolución</span>
      </div>
      <span class="eyebrow">MEJORA CONTINUA / DEVELOPMENT LOG</span>
      <h1>Cada cambio cuenta.</h1>
      <p class="lead">
        La historia del motor, un commit a la vez. Nuevos sistemas, juegos, correcciones y
        decisiones de arquitectura con una fuente que puedes consultar.
      </p>
      <div class="actions">
        <a class="button primary" href="#historial">
          Explorar historial <span>↓</span>
        </a>
      </div>
    </div>
  </section>
  <section class="section container history-layout" id="historial">
    <aside class="history-sidebar">
      <span class="eyebrow">FILTRAR HISTORIAL</span>
      <div class="history-search">
        <label for="update-search">Buscar una mejora</label>
        <input id="update-search" type="search" placeholder="Nombre o commit…" />
      </div>
      <CategoryPicker categories={categories} />
      <p class="history-note">
        Los identificadores corresponden a commits reales, no a versiones de lanzamiento. Las fechas
        conservan la zona horaria de Colombia.
      </p>
      <p id="update-count" role="status" class="mono">
        {updates.length} actualizaciones
      </p>
      <a class="text-link" href="https://github.com/Arukado01/AwesomeEngine/commits/main/">
        Historial en GitHub <span>↗</span>
      </a>
    </aside>
    <div class="timeline">
      {updates.map((entry) => (
        <article
          class="timeline-entry"
          id={entry.id}
          data-update
          data-category={entry.category}
          data-search={`${entry.title} ${entry.description} ${entry.id}`}
        >
          <div class="timeline-marker"></div>
          <div class="timeline-meta">
            <time datetime={entry.date}>{date(entry.date)}</time>
            <code>{entry.id}</code>
            <span class="pill live">Implementada</span>
          </div>
          <h2>{entry.title}</h2>
          <span class="timeline-category">{entry.category}</span>
          <p>{entry.description}</p>
          <details>
            <summary>
              Ver cambios <span>+</span>
            </summary>
            <div class="change-details">
              {[
                ['Funcionalidades agregadas', entry.added],
                ['Correcciones', entry.fixed],
                ['Rendimiento', entry.performance],
                ['Arquitectura', entry.architecture],
              ].map(
                ([title, items]) =>
                  (items as string[]).length > 0 && (
                    <div>
                      <h3>{title}</h3>
                      <ul>
                        {(items as string[]).map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </div>
                  ),
              )}
              <a class="text-link" href={entry.source}>
                Consultar commit <span>↗</span>
              </a>
            </div>
          </details>
        </article>
      ))}
      <div id="updates-empty" class="empty-state" hidden>
        <h3>Sin resultados.</h3>
        <p>No hay actualizaciones que coincidan con esos filtros.</p>
        <button id="reset-filters" class="button small">
          Restablecer filtros
        </button>
      </div>
    </div>
  </section>
</Base>
<script>
  import { plural } from '../i18n/client';
  const search = document.querySelector<HTMLInputElement>('#update-search');
  const category = document.querySelector<HTMLSelectElement>('#update-category');
  const entries = [...document.querySelectorAll<HTMLElement>('[data-update]')];
  const empty = document.querySelector<HTMLElement>('#updates-empty');
  const count = document.querySelector('#update-count');
  const normalize = (s: string) =>
    s
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase();
  function filter() {
    let n = 0;
    const q = normalize(search?.value || '');
    entries.forEach((e) => {
      e.hidden = !(
        normalize(e.dataset.search || '').includes(q) &&
        (!category || category.value === 'all' || category.value === e.dataset.category)
      );
      if (!e.hidden) n++;
    });
    if (empty) empty.hidden = n > 0;
    if (count) count.textContent = plural('updatesOne', 'updatesOther', n);
  }
  search?.addEventListener('input', filter);
  category?.addEventListener('change', filter);
  // Preserve input entered or restored before module initialization.
  filter();
  window.addEventListener('pageshow', filter);
  document.querySelector('#reset-filters')?.addEventListener('click', () => {
    if (search) search.value = '';
    if (category) {
      category.value = 'all';
      category.dispatchEvent(new window.Event('change', { bubbles: true }));
    }
    filter();
    search?.focus();
  });
</script>
<style>
  .history-layout {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: clamp(2.5rem, 1rem + 5vw, 6rem);
  }
  .history-sidebar {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    align-self: start;
  }
  .history-search label {
    display: block;
    margin: 1.5rem 0 0.5rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .history-search input {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font-size: var(--text-base);
  }
  .history-search input:hover {
    border-color: var(--border-strong);
  }
  .history-search input:focus-visible {
    outline-offset: 1px;
  }
  .history-search input::placeholder {
    color: var(--muted);
    opacity: 1;
  }
  .history-note {
    margin-top: 1.5rem;
    font-size: var(--text-sm);
    line-height: 1.75;
  }
  .history-sidebar > .mono {
    margin-block: 1.25rem;
    color: var(--accent);
  }
  .timeline {
    padding-left: 2.25rem;
    border-left: 1px solid var(--border);
  }
  .timeline-entry {
    position: relative;
    margin-bottom: 2.5rem;
    padding-bottom: 2.75rem;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: calc(var(--header-h) + 2rem);
  }
  .timeline-entry:last-of-type {
    margin-bottom: 0;
    border-bottom: 0;
  }
  .timeline-marker {
    position: absolute;
    top: 0.3rem;
    left: calc(-2.25rem - 6px);
    width: 11px;
    height: 11px;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--bg);
  }
  .timeline-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.125rem;
    color: var(--muted);
    font: var(--text-xs) var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .timeline-meta code {
    color: var(--accent);
  }
  .timeline-entry h2 {
    margin: 1.25rem 0 0.625rem;
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.875rem);
    letter-spacing: -0.03em;
  }
  .timeline-category {
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .timeline-entry > p {
    max-width: 42rem;
    margin: 1rem 0 1.25rem;
    line-height: 1.7;
  }
  .timeline-entry summary {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.5rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-soft);
    font-size: var(--text-sm);
    font-weight: 500;
    list-style: none;
  }
  .timeline-entry summary::-webkit-details-marker {
    display: none;
  }
  .timeline-entry summary:hover {
    border-color: var(--accent-line);
    color: var(--accent);
  }
  .timeline-entry summary span {
    font-size: 1.125rem;
    line-height: 1;
    transition: transform var(--duration) var(--ease-out);
  }
  .timeline-entry details[open] summary span {
    transform: rotate(45deg);
  }
  .timeline-entry details::details-content {
    interpolate-size: allow-keywords;
    overflow: clip;
    contain: layout;
  }
  .timeline-entry details:not([open])::details-content {
    block-size: 0;
  }
  .change-details {
    display: grid;
    gap: 0.25rem;
    margin-top: 1rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .change-details h3 {
    margin: 0.75rem 0 0.5rem;
    font-size: var(--text-md);
    letter-spacing: -0.01em;
  }
  .change-details > div:first-child h3 {
    margin-top: 0;
  }
  .change-details ul {
    margin: 0 0 0.5rem;
    padding-left: 1.125rem;
    color: var(--text-soft);
    font-size: var(--text-sm);
    line-height: 1.75;
  }
  .change-details li::marker {
    color: var(--accent);
  }
  .change-details .text-link {
    justify-self: start;
    margin-top: 0.5rem;
  }
  .empty-state button {
    margin-top: 1.25rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .timeline-entry details::details-content {
      transition:
        block-size 300ms var(--ease-out),
        content-visibility 300ms allow-discrete;
    }
  }
  @media (max-width: 900px) {
    .history-layout {
      grid-template-columns: 12.5rem minmax(0, 1fr);
      gap: 2.5rem;
    }
    .timeline {
      padding-left: 1.5rem;
    }
    .timeline-marker {
      left: calc(-1.5rem - 6px);
    }
  }
  @media (max-width: 640px) {
    .history-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .history-sidebar {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 1rem;
    }
    .history-sidebar .eyebrow,
    .history-note,
    .history-sidebar > .mono,
    .history-sidebar > .text-link {
      grid-column: 1/-1;
    }
    .history-search,
    .history-search input {
      min-width: 0;
    }
    .history-sidebar .history-note {
      margin-top: 1.25rem;
    }
    .change-details {
      padding: 1rem 1.125rem;
    }
  }
</style>
