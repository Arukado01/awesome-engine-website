---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" noindex>
  <section class="container error-page">
    <span class="error-number" aria-hidden="true">
      404
    </span>
    <span class="eyebrow">ESCENA NO ENCONTRADA</span>
    <h1>
      Este camino
      <br />
      todavía no existe.
    </h1>
    <p>
      La página pudo cambiar de lugar o la dirección no es correcta. Volvamos a un punto conocido.
    </p>
    <div class="actions">
      <a class="button primary" href="/">
        Volver al inicio <span>↗</span>
      </a>
      <a class="button" href="/docs/">
        Abrir documentación <span>→</span>
      </a>
    </div>
  </section>
</Base>
<style>
  .error-page {
    min-height: 70vh;
    padding-block: 80px;
    position: relative;
  }
  .error-number {
    font: 500 120px/0.9 var(--font-display);
    color: var(--border);
    display: block;
    margin-bottom: 40px;
  }
  .error-page h1 {
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    margin-bottom: 24px;
  }
  .error-page p {
    max-width: 460px;
    font-size: 14px;
    margin-bottom: 30px;
  }
  @media (max-width: 640px) {
    .error-page {
      padding-block: 50px;
    }
    .error-number {
      font-size: 90px;
    }
  }
</style>
