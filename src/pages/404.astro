---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" noindex>
  <section class="container error-page">
    <span class="error-number" aria-hidden="true">
      404
    </span>
    <span class="eyebrow">ESCENA NO ENCONTRADA</span>
    <h1>
      Este camino
      <br />
      todavía no existe.
    </h1>
    <p>
      La página pudo cambiar de lugar o la dirección no es correcta. Volvamos a un punto conocido.
    </p>
    <div class="actions">
      <a class="button primary" href="/">
        Volver al inicio <span>↗</span>
      </a>
      <a class="button" href="/docs/">
        Abrir documentación <span>→</span>
      </a>
    </div>
  </section>
</Base>
<style>
  .error-page {
    position: relative;
    min-height: 70vh;
    padding-block: clamp(3.5rem, 2rem + 5vw, 6rem);
  }
  .error-number {
    display: block;
    margin-bottom: 2rem;
    color: transparent;
    font: 600 clamp(6rem, 4rem + 8vw, 10rem) / 0.9 var(--font-display);
    letter-spacing: -0.04em;
    -webkit-text-stroke: 1px var(--border-strong);
  }
  .error-page h1 {
    max-width: 16ch;
    margin-bottom: 1.5rem;
    font-size: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
  }
  .error-page p {
    max-width: 30rem;
    margin-bottom: 2rem;
    font-size: var(--text-lead);
  }
</style>
