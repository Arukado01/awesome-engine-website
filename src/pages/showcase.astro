---
import Base from '../layouts/Base.astro';
import { games } from '../data/engine';
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
interface MediaGame {
  id: string;
  name: string;
  description: string;
  systems: string[];
  source: string;
  screenshots: { src: string; title: string; alt: string }[];
  videos: { src: string; poster: string; title: string; duration: number; audio: boolean }[];
  width: number;
  height: number;
}
const manifest = join(process.cwd(), 'src/data/showcase-media.json');
const showcase: MediaGame[] = existsSync(manifest)
  ? JSON.parse(readFileSync(manifest, 'utf8').replace(/^\uFEFF/, ''))
  : [];
---

<Base
  title="Showcase — Juegos en movimiento"
  description="Capturas y grabaciones auténticas de Runner y Plaguefront ejecutándose con Awesome Engine. Explora sus mecánicas, entornos y sistemas."
>
  <section class="page-intro">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Inicio</a>
        <span>/</span>
        <span>Showcase</span>
      </div>
      <span class="eyebrow">HECHO CON AWESOME ENGINE</span>
      <h1>
        Del código
        <br />
        <span class="muted">a una partida real.</span>
      </h1>
      <div class="showcase-intro-row">
        <p class="lead">
          Juegos ejecutándose. Escenarios que se mueven. Cada imagen y cada video de esta galería
          provienen de una ejecución real.
        </p>
        <div class="showcase-shortcuts">
          {showcase.map((g) => (
            <a class="button small" href={`#${g.id}`}>
              {g.name} <span>↓</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
  {showcase.map((game, index) => (
    <section class="section container game-showcase" id={game.id}>
      <div class="game-heading">
        <div>
          <span class="eyebrow">0{index + 1} / SHOWCASE</span>
          <h2>{game.name}</h2>
        </div>
        <span class="pill live">Captura de ejecución real</span>
      </div>
      <div class="game-overview">
        <div class="game-featured">
          <button
            class="gallery-trigger featured-trigger"
            data-gallery={game.id}
            data-src={game.screenshots[0]?.src}
            data-title={game.screenshots[0]?.title}
            data-alt={game.screenshots[0]?.alt}
            aria-label={`Ampliar ${game.screenshots[0]?.title}`}
          >
            <img
              src={game.screenshots[0]?.src}
              width={game.width}
              height={game.height}
              alt={game.screenshots[0]?.alt}
              loading="lazy"
            />
            <span class="expand-image" aria-hidden="true">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
              </svg>
            </span>
          </button>
        </div>
        <div class="game-description">
          <span class="mono">EL JUEGO</span>
          <p>{game.description}</p>
          <h3>Sistemas en acción</h3>
          <ul class="system-tags">
            {game.systems.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
          <p class="capture-note">
            Grabado en resolución nativa {game.width} × {game.height}. Se conserva la relación de
            aspecto del juego.
          </p>
          {game.source && (
            <a class="text-link" href={game.source}>
              Explorar proyecto <span>↗</span>
            </a>
          )}
        </div>
      </div>
      <div class="gallery-heading">
        <h3>Dentro del juego</h3>
        <span>Selecciona una captura para ampliarla</span>
      </div>
      <div
        class="screenshot-gallery"
        style={`--shot-ratio: ${game.width} / ${game.height}; --shot-cols: ${game.width / game.height > 1.2 ? 2 : 4}; --shot-cols-sm: ${game.width / game.height > 1.2 ? 1 : 2}`}
      >
        {game.screenshots.slice(1).map((s, i) => (
          <figure>
            <button
              class="gallery-trigger"
              data-gallery={game.id}
              data-src={s.src}
              data-title={s.title}
              data-alt={s.alt}
              aria-label={`Ampliar ${s.title}`}
            >
              <img
                src={s.src}
                alt={s.alt}
                width={game.width}
                height={game.height}
                loading="lazy"
                decoding="async"
              />
              <span class="expand-image" aria-hidden="true">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
                </svg>
              </span>
            </button>
            <figcaption>
              <span class="mono">{String(i + 2).padStart(2, '0')}</span>
              {s.title}
            </figcaption>
          </figure>
        ))}
      </div>
      {game.videos.length > 0 && (
        <div class="video-section">
          <div class="gallery-heading">
            <h3>En movimiento</h3>
            <span>Gameplay auténtico · Velocidad original</span>
          </div>
          <div class="video-grid">
            {game.videos.map((v, i) => (
              <figure class="video-figure">
                <div class="video-wrap">
                  <video
                    controls
                    playsinline
                    preload="none"
                    poster={v.poster}
                    width={game.width}
                    height={game.height}
                    aria-label={`${game.name}: ${v.title}`}
                    aria-describedby={`${game.id}-video-${i}`}
                  >
                    <source src={v.src} type="video/mp4" />
                    Tu navegador no admite este reproductor. <a href={v.src}>Descargar video MP4</a>
                    .
                  </video>
                  <div class="video-loading" hidden role="status">
                    <span class="skeleton"></span>
                    <span>Cargando video…</span>
                  </div>
                  <p class="video-error" hidden role="alert">
                    No pudimos cargar este video. Comprueba tu conexión o{' '}
                    <a href={v.src}>abre el archivo MP4</a>.
                  </p>
                </div>
                <figcaption id={`${game.id}-video-${i}`}>
                  <strong>{v.title}</strong>
                  <span>
                    {v.duration} s · H.264{!v.audio ? ' · Sin audio' : ''}
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      )}
    </section>
  ))}
  {showcase.length === 0 && (
    <section class="section container">
      <div class="empty-state">
        <h2>Preparando las grabaciones.</h2>
        <p>Las capturas se incorporan después de verificar las ejecuciones reales de cada juego.</p>
      </div>
    </section>
  )}
  <section class="section catalogue-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">ESCENAS DEL REPOSITORIO</span>
          <h2>Siete formas de explorar el motor.</h2>
        </div>
        <p>
          Cada escena resuelve un tipo de juego distinto. El código permite seguir sus decisiones,
          mecánicas y sistemas.
        </p>
      </div>
      <div class="game-catalogue">
        {games.map((game, i) => (
          <details>
            <summary>
              <span class="mono">0{i + 1}</span>
              <span class="game-name">{game.name}</span>
              <span class="game-genre">{game.genre}</span>
              <span class="details-sign">+</span>
            </summary>
            <div class="game-detail">
              <p>{game.description}</p>
              <a class="text-link" href={game.source}>
                Ver implementación <span>↗</span>
              </a>
            </div>
          </details>
        ))}
      </div>
      <p class="catalogue-note">
        El motor registra nueve juegos. El menú muestra ocho con la configuración incluida.
        Plaguefront es un proyecto independiente que usa el motor.
      </p>
    </div>
  </section>
  <dialog id="gallery-dialog" aria-labelledby="gallery-title">
    <div class="dialog-head">
      <h2 id="gallery-title">Captura del juego</h2>
      <button type="button" id="gallery-close" aria-label="Cerrar galería">
        Cerrar ×
      </button>
    </div>
    <img id="gallery-image" class="dialog-image" src="/images/runner-hero.webp" alt="" />
    <div class="gallery-controls">
      <button class="button small" id="gallery-prev" aria-label="Captura anterior">
        ← Anterior
      </button>
      <span id="gallery-count" class="mono" aria-live="polite"></span>
      <button class="button small" id="gallery-next" aria-label="Captura siguiente">
        Siguiente →
      </button>
    </div>
    <p class="dialog-caption" id="gallery-caption"></p>
  </dialog>
  <script>
    import '../scripts/showcase';
  </script>
</Base>
<style>
  .showcase-intro-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
  }
  .showcase-intro-row .lead {
    margin-bottom: 0;
  }
  .showcase-shortcuts {
    display: flex;
    flex-wrap: wrap;
    flex-shrink: 0;
    gap: 0.75rem;
  }
  .game-showcase {
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .game-showcase + .game-showcase {
    border-top: 1px solid var(--border);
  }
  .game-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: 2.25rem;
  }
  .game-heading h2 {
    font-size: clamp(2.75rem, 1.8rem + 3.4vw, 4.5rem);
    letter-spacing: var(--tracking-display);
  }
  .game-overview {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 3vw, 3.5rem);
    align-items: center;
  }
  .game-featured {
    min-width: 0;
  }
  .gallery-trigger {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: #070a12;
    color: var(--text);
  }
  .gallery-trigger:hover {
    border-color: var(--accent-line);
  }
  .gallery-trigger img {
    width: 100%;
    height: auto;
    transition:
      filter 180ms ease,
      transform 600ms var(--ease-out);
  }
  .gallery-trigger:hover img {
    filter: brightness(1.06);
    transform: scale(1.02);
  }
  .featured-trigger img {
    max-height: 37.5rem;
    object-fit: contain;
    background: #070a12;
  }
  .expand-image {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid #ffffff45;
    border-radius: var(--radius);
    background: #101218d9;
    color: #f2f2f5;
    transition:
      border-color var(--transition),
      color var(--transition);
  }
  .gallery-trigger:hover .expand-image,
  .gallery-trigger:focus-visible .expand-image {
    border-color: #c2b2ff;
    color: #c2b2ff;
  }
  .game-description > .mono {
    color: var(--accent);
    font-size: var(--text-2xs);
    letter-spacing: 0.12em;
  }
  .game-description > p {
    margin: 1.25rem 0 2rem;
    color: var(--text-soft);
    font-size: var(--text-lead);
    line-height: 1.75;
  }
  .game-description h3 {
    margin-bottom: 1rem;
    font-size: var(--text-lg);
  }
  .system-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .system-tags li {
    padding: 0.3125rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text-soft);
    font-size: var(--text-xs);
  }
  .game-description > .capture-note {
    margin-block: 1.75rem;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .gallery-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
    margin: 3rem 0 1.25rem;
  }
  .gallery-heading h3 {
    font-size: var(--text-2xl);
  }
  .gallery-heading > span {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  /* Each game keeps its native aspect ratio; square games get four columns, wide games two. */
  .screenshot-gallery {
    display: grid;
    grid-template-columns: repeat(var(--shot-cols, 3), minmax(0, 1fr));
    gap: 1.25rem;
  }
  .screenshot-gallery figure {
    min-width: 0;
    margin: 0;
  }
  .screenshot-gallery img {
    aspect-ratio: var(--shot-ratio, 16 / 10);
    object-fit: contain;
    background: #080b12;
  }
  .screenshot-gallery figcaption {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .screenshot-gallery figcaption .mono {
    margin-top: 0.15rem;
    color: var(--accent);
    font-size: var(--text-2xs);
  }
  .video-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .video-figure {
    min-width: 0;
    margin: 0;
  }
  .video-wrap {
    position: relative;
  }
  .video-wrap video {
    width: 100%;
    height: auto;
    max-height: 31.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: #080a11;
  }
  .video-figure figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-top: 0.875rem;
  }
  .video-figure strong {
    font-size: var(--text-md);
    font-weight: 600;
  }
  .video-figure figcaption > span {
    color: var(--muted);
    font: var(--text-xs) var(--font-mono);
    white-space: nowrap;
  }
  .video-loading {
    position: absolute;
    inset: 35% 20% auto;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: var(--text-sm);
    text-align: center;
    pointer-events: none;
  }
  .video-loading .skeleton {
    display: block;
    margin-bottom: 0.75rem;
  }
  .video-error {
    margin-top: 0.75rem;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--danger) 60%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--danger) 8%, transparent);
    color: var(--danger);
    font-size: var(--text-sm);
  }
  .video-error a {
    text-decoration: underline;
  }
  .catalogue-section {
    border-top: 1px solid var(--border);
    background: var(--surface);
  }
  .game-catalogue details {
    border-bottom: 1px solid var(--border);
  }
  .game-catalogue details:first-child {
    border-top: 1px solid var(--border);
  }
  .game-catalogue summary {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) minmax(0, 1fr) 2rem;
    align-items: center;
    gap: 1.5rem;
    padding: 1.375rem 0;
    list-style: none;
  }
  .game-catalogue summary::-webkit-details-marker {
    display: none;
  }
  .game-catalogue summary .mono {
    color: var(--muted);
  }
  .game-name {
    font: 600 clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem) / 1.25 var(--font-display);
    letter-spacing: -0.02em;
  }
  .game-catalogue summary:hover .game-name {
    color: var(--accent);
  }
  .game-genre {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .details-sign {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--accent);
    font-size: 1.125rem;
    line-height: 1;
    transition:
      border-color var(--transition),
      transform var(--duration) var(--ease-out);
  }
  .game-catalogue summary:hover .details-sign {
    border-color: var(--accent-line);
  }
  .game-catalogue details[open] .details-sign {
    transform: rotate(45deg);
  }
  .game-catalogue details::details-content {
    interpolate-size: allow-keywords;
    overflow: clip;
    contain: layout;
  }
  .game-catalogue details:not([open])::details-content {
    block-size: 0;
  }
  .game-detail {
    max-width: 48rem;
    padding: 0 4rem 1.75rem;
  }
  .game-detail p {
    font-size: var(--text-md);
    line-height: 1.8;
  }
  .catalogue-note {
    margin-top: 1.5rem;
    font-size: var(--text-sm);
  }
  .gallery-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 1rem;
  }
  .dialog-head h2 {
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
  }
  .gallery-controls .mono {
    color: var(--muted);
  }
  @media (prefers-reduced-motion: no-preference) {
    .game-catalogue details::details-content {
      transition:
        block-size 300ms var(--ease-out),
        content-visibility 300ms allow-discrete;
    }
  }
  @media (max-width: 900px) {
    .showcase-intro-row {
      flex-direction: column;
      align-items: start;
    }
    .game-overview {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 2rem;
    }
    .video-figure figcaption {
      flex-direction: column;
      align-items: start;
      gap: 0.375rem;
    }
  }
  @media (max-width: 640px) {
    .game-heading {
      flex-direction: column;
      align-items: start;
      gap: 1rem;
    }
    .game-overview {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }
    .gallery-heading {
      flex-direction: column;
      gap: 0.375rem;
    }
    .screenshot-gallery {
      grid-template-columns: repeat(var(--shot-cols-sm, 2), minmax(0, 1fr));
      gap: 1.25rem 0.75rem;
    }
    .video-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
    .game-catalogue summary {
      grid-template-columns: 1.75rem minmax(0, 1fr) 2rem;
      gap: 0.25rem 1rem;
    }
    .game-genre {
      grid-column: 2;
    }
    .details-sign {
      grid-column: 3;
      grid-row: 1 / span 2;
    }
    .game-detail {
      padding: 0 0 1.5rem 2.75rem;
    }
    .dialog-head h2 {
      font-size: var(--text-lg);
    }
    .gallery-controls {
      gap: 0.625rem;
    }
    .gallery-controls .button {
      padding-inline: 0.625rem;
    }
  }
</style>
