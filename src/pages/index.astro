---
import Base from '../layouts/Base.astro';
import { getLocale, localeInfo } from '../i18n/locales';
const currentLocale = localeInfo[getLocale(Astro.url.pathname)].html;
import '../styles/home.css';
import Pipeline from '../components/Pipeline.astro';
import { updates } from '../data/updates';
const latest = updates.slice(0, 3);
const updateDate = new Intl.DateTimeFormat(currentLocale, {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
  timeZone: 'America/Bogota',
});
const formatUpdateDate = (value: string) =>
  updateDate.format(new Date(value)).toLocaleUpperCase(currentLocale);
---

<Base title="Ideas en código. Mundos en movimiento.">
  <section class="hero container">
    <div class="hero-copy">
      <div class="hero-label">
        <span class="status-dot"></span> MOTOR 2D · CÓDIGO ABIERTO <span class="label-line"></span>
      </div>
      <h1>
        Ideas en código.
        <br />
        Mundos en
        <br />
        <span>movimiento.</span>
      </h1>
      <p class="hero-description">
        Un motor de videojuegos en C++ para explorar lo que puedes construir. Renderizado 2D,
        escenas, audio y herramientas, en una arquitectura que puedes conocer de principio a fin.
      </p>
      <div class="actions">
        <a class="button primary" href="/docs/instalacion/">
          Empieza a construir <span aria-hidden="true">↗</span>
        </a>
        <a class="button" href="/showcase/">
          Explora los juegos <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="hero-footnote">
        <span class="mini-terminal">&gt;_</span>
        <span>C++20 / SFML 3.1 / Tu siguiente idea.</span>
      </div>
    </div>
    <figure class="hero-visual">
      <div class="viewport-bar">
        <span class="viewport-dots">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <span>Awesome Engine / Runner</span>
        <span class="mono">2D</span>
      </div>
      <a href="/showcase/#runner" aria-label="Ver el showcase de Runner">
        <img
          src="/images/runner-hero.webp"
          width="800"
          height="800"
          alt="Captura real de Runner: un personaje corre entre obstáculos sobre los tejados de una ciudad iluminada."
          fetchpriority="high"
        />
      </a>
      <figcaption>
        <span>
          <span class="status-dot"></span> EJECUTADO CON AWESOME ENGINE
        </span>
        <a href="/showcase/#runner" aria-label="Explorar Runner">
          ↗
        </a>
      </figcaption>
      <div class="visual-coordinate" aria-hidden="true">
        X: 2D &nbsp; Y: POSIBILIDADES
      </div>
    </figure>
  </section>
  <div class="tech-strip">
    <div class="container">
      <span class="tech-strip-label">
        CONSTRUIDO SOBRE
        <br />
        <strong>BUENAS BASES.</strong>
      </span>
      <span class="tech-word">
        C++<sup>20</sup>
      </span>
      <span class="tech-word sfml">◈ SFML</span>
      <span class="tech-word">
        TGUI<span class="tech-version">1.13</span>
      </span>
      <span class="tech-word cmake">△ CMake</span>
      <a class="text-link" href="/motor/#tecnologias">
        Ver tecnologías <span>↗</span>
      </a>
    </div>
  </div>
  <section class="section container" id="caracteristicas">
    <div class="section-heading">
      <div>
        <span class="eyebrow">01 / Dentro del motor</span>
        <h2>
          Las piezas para dar
          <br />
          vida a tus ideas.
        </h2>
      </div>
      <p>
        Del primer evento al último píxel. Sistemas concretos que trabajan juntos, con su
        implementación abierta para explorarla.
      </p>
    </div>
    <div class="feature-grid">
      <a class="feature feature-render" href="/docs/renderizado/">
        <div class="feature-top">
          <span class="mono">01 — GRÁFICOS</span>
          <span class="pill live">Implementado</span>
        </div>
        <div class="render-visual" aria-hidden="true">
          <div class="visual-grid"></div>
          <div class="wire-cube cube-one"></div>
          <div class="wire-cube cube-two"></div>
          <span class="render-caption">SCENE → TEXTURE → EFFECTS</span>
        </div>
        <div class="feature-bottom">
          <div>
            <h3>Cada píxel, una intención.</h3>
            <p>Renderizado 2D con SFML y una cadena de efectos bloom y monitor sobre la escena.</p>
          </div>
          <span class="feature-arrow">↗</span>
        </div>
      </a>
      <div class="feature-right">
        <a class="feature feature-scene" href="/docs/escenas/">
          <div class="feature-top">
            <span class="mono">02 — ARQUITECTURA</span>
            <span class="feature-arrow">↗</span>
          </div>
          <div class="scene-tabs" aria-hidden="true">
            <span>Start()</span>
            <span>Update()</span>
            <span>Render()</span>
          </div>
          <h3>Tu juego. Su propia escena.</h3>
          <p>Ciclo de vida definido y servicios compartidos mediante EngineContext.</p>
        </a>
        <a class="feature feature-input" href="/docs/entrada-audio/">
          <div class="feature-top">
            <span class="mono">03 — INTERACCIÓN</span>
            <span class="feature-arrow">↗</span>
          </div>
          <div class="key-row" aria-hidden="true">
            <kbd>W</kbd>
            <kbd>A</kbd>
            <kbd>S</kbd>
            <kbd>D</kbd>
            <span>+</span>
            <span class="controller">✣</span>
          </div>
          <h3>Conecta acción y respuesta.</h3>
          <p>Entrada por acciones, teclado, ratón, gamepad y audio para acompañar cada partida.</p>
        </a>
      </div>
    </div>
    <div class="feature-more">
      <span class="muted">También: recursos, partículas, interfaz, guardado JSON y capturas.</span>
      <a class="text-link" href="/motor/">
        Conoce el motor <span>→</span>
      </a>
    </div>
  </section>
  <section class="architecture-band section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">02 / Una arquitectura que se entiende</span>
          <h2>
            Del código a la pantalla.
            <br />
            <span class="muted">Sin cajas negras.</span>
          </h2>
        </div>
        <p>
          El motor coordina. La escena define el juego. Los gestores se ocupan de los recursos y
          sistemas que necesitas.
        </p>
      </div>
      <Pipeline />
      <div class="architecture-bottom">
        <p>
          Una representación del pipeline implementado en <code>RenderManager</code>.
        </p>
        <a href="/motor/#arquitectura" class="text-link">
          Explora la arquitectura <span>↗</span>
        </a>
      </div>
    </div>
  </section>
  <section class="section container">
    <div class="section-heading">
      <div>
        <span class="eyebrow">03 / Hecho con Awesome Engine</span>
        <h2>El código cobra vida.</h2>
      </div>
      <a class="text-link" href="/showcase/">
        Abrir showcase <span>↗</span>
      </a>
    </div>
    <a href="/showcase/#runner" class="showcase-preview">
      <div class="showcase-image">
        <img
          src="/images/runner-hero.webp"
          alt="Gameplay real de Runner con ciudad en capas, obstáculos y HUD de distancia."
          width="800"
          height="800"
          loading="lazy"
        />
      </div>
      <div class="showcase-copy">
        <span class="pill">ESCENA DEL MOTOR</span>
        <h3>Runner</h3>
        <p>
          Una ciudad que no se detiene.
          <br />
          Corre, salta y deslízate.
        </p>
        <div class="tag-list">
          <span>Parallax</span>
          <span>Sprites</span>
          <span>Partículas</span>
          <span>Audio</span>
        </div>
        <span class="text-link">
          Ver el juego en acción <span>↗</span>
        </span>
      </div>
    </a>
  </section>
  <section class="section code-section container">
    <div>
      <span class="eyebrow">04 / Empieza por lo esencial</span>
      <h2>
        Lee el código.
        <br />
        Entiende el motor.
        <br />
        <span class="muted">Construye lo siguiente.</span>
      </h2>
      <p>
        Una base C++20, dependencias declaradas con CMake y documentación conectada con el código
        fuente.
      </p>
      <a class="button primary" href="/docs/">
        Explorar documentación <span>↗</span>
      </a>
    </div>
    <div class="code-wrap">
      <div class="code-toolbar">
        <span>Engine / Source / Main.cpp</span>
        <button data-copy aria-label="Copiar ejemplo del bucle principal">
          Copiar
        </button>
      </div>
      <pre is:raw><code><span class="kw">int</span> <span class="fn">main</span>() {
  Engine engine;

  <span class="kw">while</span> (engine.<span class="fn">IsRunning</span>()) {
    engine.<span class="fn">ProcessEvent</span>();
    engine.<span class="fn">Update</span>();

    <span class="kw">if</span> (!engine.<span class="fn">HasFocus</span>()) {
      sf::<span class="fn">sleep</span>(sf::<span class="fn">milliseconds</span>(10));
      <span class="kw">continue</span>;
    }

    engine.<span class="fn">Render</span>();
  }
}</code></pre>
      <div class="code-source">
        Bucle real del motor ·{' '}
        <a href="https://github.com/Arukado01/AwesomeEngine/blob/5a6dfacd86414c4cdfaa7157b533330f173a3126/Engine/Source/Main.cpp">
          Ver fuente ↗
        </a>
      </div>
    </div>
  </section>
  <section class="section evolution-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">05 / Mejora continua</span>
          <h2>Un motor en movimiento.</h2>
        </div>
        <a class="text-link" href="/evolucion/">
          Ver toda la evolución <span>↗</span>
        </a>
      </div>
      <div class="latest-updates">
        {latest.map((entry) => (
          <a class="latest-update" href={`/evolucion/#${entry.id}`}>
            <div>
              <span class="mono">{entry.id}</span>
              <span class="pill">{entry.category}</span>
            </div>
            <h3>{entry.title}</h3>
            <p>{entry.description}</p>
            <span class="update-date">
              <time datetime={entry.date}>{formatUpdateDate(entry.date)}</time>{' '}
              <span aria-hidden="true">↗</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="container final-cta">
    <div>
      <span class="eyebrow">EL SIGUIENTE PASO ES TUYO</span>
      <h2>
        Abre el código.
        <br />
        Enciende una idea.
      </h2>
    </div>
    <div class="actions">
      <a class="button primary" href="https://github.com/Arukado01/AwesomeEngine">
        Ver en GitHub <span>↗</span>
      </a>
      <a class="button" href="/contacto/">
        Hablemos <span>→</span>
      </a>
    </div>
  </section>
</Base>
