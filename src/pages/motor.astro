---
import Base from '../layouts/Base.astro';
import TestingSection from '../components/TestingSection.astro';
import Pipeline from '../components/Pipeline.astro';
import { technologies } from '../data/engine';
const systems = [
  [
    'Renderizado y vistas',
    'Sprites, formas y texto sobre sf::RenderTexture. Pantalla completa con Alt + Enter, ajuste proporcional y posprocesado Bloom y Monitor.',
    'renderizado',
  ],
  [
    'Escenas y ciclo de vida',
    'Start, Update, Render, OnEvent, OnPause y OnCleanup. Cambio de escena diferido y reinicio.',
    'escenas',
  ],
  [
    'Recursos y memoria',
    'Cachés de texturas, sonidos y fuentes. RAII, contenedores estándar y ownership con unique_ptr.',
    'recursos',
  ],
  [
    'Entrada y audio',
    'Acciones con múltiples bindings. Teclado, ratón y gamepad; grupos de música y efectos por escena.',
    'entrada-audio',
  ],
  [
    'Animación de sprites',
    'Clips, eventos de fotograma y grupos de animación reutilizables.',
    'renderizado',
  ],
  [
    'Colisiones 2D',
    'Intersección y barrido continuo de cajas alineadas a los ejes.',
    'renderizado',
  ],
  [
    'Partículas y ráfagas',
    'Emisores configurables, velocidad, duración y límite de partículas.',
    'renderizado',
  ],
  [
    'Tiempo y pausa',
    'Relojes de juego y tiempo real; temporizadores vinculados a la pausa.',
    'arquitectura',
  ],
  [
    'Interfaz y herramientas',
    'TGUI, overlay de pausa, cursor personalizado, capturas PNG con F12 y diagnóstico con spdlog.',
    'arquitectura',
  ],
  [
    'Configuración y guardado',
    'Configuración de ventana, tiempo y audio en JSON. Persistencia local de puntuaciones y estado.',
    'configuracion',
  ],
];
---

<Base
  title="El motor"
  description="Arquitectura, sistemas, tecnologías y límites reales de Awesome Engine, verificados en su código fuente."
>
  <section class="page-intro">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Inicio</a>
        <span>/</span>
        <span>El motor</span>
      </div>
      <span class="eyebrow">C++20 · SFML · CÓDIGO ABIERTO</span>
      <h1>
        Pequeñas piezas.
        <br />
        <span class="muted">Posibilidades en movimiento.</span>
      </h1>
      <p class="lead">
        Awesome Engine es un motor 2D organizado en escenas. Un contexto compartido reúne los
        sistemas que cada juego utiliza, desde la entrada hasta el último cuadro.
      </p>
      <a
        class="text-link"
        href="https://github.com/Arukado01/AwesomeEngine/tree/61a3244690f7763d41a8f0ba6f0f2ac3deb53ee2"
      >
        Explorar el código auditado <span>↗</span>
      </a>
    </div>
  </section>
  <section class="section container about-layout">
    <div>
      <span class="eyebrow">Acerca del proyecto</span>
      <h2>
        Una base que
        <br />
        puedes entender.
      </h2>
    </div>
    <div>
      <p>
        Desarrollado por Carlos Cortina, Awesome Engine reúne lógica de juego en C++ y servicios
        reutilizables sobre SFML. Incluye nueve escenas de juego y un menú principal configurable.
      </p>
      <p>
        Su diseño favorece la composición: las escenas reciben un <code>EngineContext</code> y usan
        gestores con responsabilidades concretas. El código MIT permite estudiar, modificar y
        ampliar esa base.
      </p>
      <p class="small-note">
        El repositorio aún no publica una historia de creación ni objetivos formales. Aquí
        describimos su diseño observable y sus capacidades verificadas.
      </p>
    </div>
  </section>
  <section class="section system-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Capacidades verificadas</span>
          <h2>Lo que ya puedes explorar.</h2>
        </div>
        <span class="pill live">Base pública: 61a3244</span>
      </div>
      <div class="systems">
        {systems.map(([title, description, doc], i) => (
          <a href={`/docs/${doc}/`} class="system-row">
            <span class="system-number">{String(i + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{description}</p>
            <span class="pill live">Implementada</span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section container" id="arquitectura">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Arquitectura general</span>
        <h2>
          Un contexto.
          <br />
          Sistemas conectados.
        </h2>
      </div>
      <p>
        Los gestores viven por valor en EngineContext. SceneFactory construye y posee las escenas
        mediante unique_ptr.
      </p>
    </div>
    <div class="architecture-diagram">
      <div class="engine-node">
        <span class="mono">PUNTO DE ENTRADA</span>
        <strong>main() → Engine</strong>
        <small>ProcessEvent → Update → Render</small>
      </div>
      <div class="connector" aria-hidden="true"></div>
      <div class="architecture-columns">
        <div class="arch-node">
          <span class="mono">CONTEXTO COMPARTIDO</span>
          <h3>EngineContext</h3>
          <div class="manager-grid">
            {[
              'Render',
              'Resource',
              'Audio',
              'Input',
              'Particle',
              'Animation',
              'Collision',
              'Time',
              'Scene',
              'Gui',
              'Cursor',
              'Save',
              'Random',
              'Screenshot',
              'Clipboard',
            ].map((name) => (
              <span>{name}</span>
            ))}
          </div>
        </div>
        <div class="arch-node">
          <span class="mono">CICLO DE VIDA</span>
          <h3>SceneFactory → Scene</h3>
          <p>Menu · Bounce · Clicker · MemoryCard · TicTacToe · MineSweeper · Runner · Tetris · Pong · Breakout</p>
          <div class="scene-flow">
            <span>Start</span>
            <span>Update</span>
            <span>Render</span>
            <span>OnEvent</span>
            <span>OnPause</span>
            <span>OnCleanup</span>
          </div>
        </div>
      </div>
      <div class="diagram-caption">
        Vista conceptual del código implementado ·{' '}
        <a href="/docs/arquitectura/">Ver referencias y responsabilidades ↗</a>
      </div>
    </div>
    <h3 class="pipeline-title">El viaje de un cuadro</h3>
    <Pipeline />
    <p class="small-note pipeline-note">
      La interfaz y el cursor se dibujan después del posprocesado de la escena. Glitch e inversión
      existen en el código, pero no están activos en la cadena auditada.
    </p>
  </section>
  <hr class="section-divider" />
  <div class="section container">
    <TestingSection />
  </div>
  <section class="section tech-section" id="tecnologias">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Stack del motor</span>
          <h2>
            Herramientas concretas.
            <br />
            Versiones explícitas.
          </h2>
        </div>
        <a
          class="text-link"
          href="https://github.com/Arukado01/AwesomeEngine/blob/61a3244690f7763d41a8f0ba6f0f2ac3deb53ee2/CMakeLists.txt"
        >
          Ver CMakeLists.txt <span>↗</span>
        </a>
      </div>
      <div class="technology-list">
        {technologies.map((t) => (
          <div>
            <strong>{t.name}</strong>
            <span class="mono">{t.version}</span>
            <p>{t.role}</p>
            <a
              class="text-link technology-link"
              href={t.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${t.linkLabel} de ${t.name} (se abre en una pestaña nueva)`}
              title="Se abre en una pestaña nueva"
            >
              {t.linkLabel} <span aria-hidden="true">↗</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section container limits">
    <div>
      <span class="eyebrow">Alcance actual</span>
      <h2>
        También importa
        <br />
        conocer los límites.
      </h2>
    </div>
    <div>
      <p>
        La configuración de desarrollo encontrada es Windows con MinGW, Ninja y GDB. Linux y macOS
        no están verificados; hay diferencias de mayúsculas en rutas que requieren revisión.
      </p>
      <p>
        El motor no incluye editor visual, ECS, motor físico general, scripting ni exportación web o
        móvil. Las colisiones y la física de los juegos son específicas de cada escena.
      </p>
      <div class="notice">
        <strong>Una limitación conocida:</strong> el overlay solicita una escena “Menu” que no está
        registrada. La documentación detalla este caso y otros problemas comprobados.
      </div>
      <a class="text-link" href="/docs/problemas/">
        Consultar limitaciones y soluciones <span>→</span>
      </a>
    </div>
  </section>
</Base>
<style>
  .about-layout,
  .limits {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 1rem + 6vw, 7rem);
  }
  .about-layout p,
  .limits p {
    max-width: 62ch;
    font-size: var(--text-base);
  }
  .about-layout code {
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-xs);
    background: var(--surface-2);
    color: var(--text);
    font-size: 0.85em;
  }
  .about-layout .small-note,
  .small-note {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .system-section,
  .tech-section {
    border-block: 1px solid var(--border);
    background: var(--surface);
  }
  .system-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 0.9fr) minmax(0, 1.3fr) auto 1.25rem;
    align-items: center;
    gap: 1.5rem;
    margin-inline: -0.75rem;
    padding: 1.375rem 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  .system-row:first-child {
    border-top: 1px solid var(--border);
  }
  .system-row:hover {
    background: color-mix(in srgb, var(--accent) 5%, transparent);
  }
  .system-row:hover h3 {
    color: var(--accent);
  }
  .system-number {
    color: var(--muted);
    font: var(--text-xs) var(--font-mono);
  }
  .system-row h3 {
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
  }
  .system-row p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.65;
  }
  .system-row .pill {
    justify-self: start;
  }
  .system-row > span:last-child {
    color: var(--muted);
    transition:
      color var(--transition),
      transform var(--duration) var(--ease-out);
  }
  .system-row:hover > span:last-child {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
  .architecture-diagram {
    padding: clamp(1.25rem, 0.5rem + 3vw, 2.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--surface);
  }
  .engine-node {
    display: grid;
    gap: 0.75rem;
    width: min(22rem, 100%);
    margin: auto;
    padding: 1.5rem;
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-lg);
    background: var(--accent-soft);
    text-align: center;
  }
  .engine-node .mono,
  .arch-node > .mono {
    color: var(--accent);
    font-size: var(--text-2xs);
    letter-spacing: 0.12em;
  }
  .engine-node strong {
    font: 600 1.5rem var(--font-display);
    letter-spacing: -0.02em;
  }
  .engine-node small {
    color: var(--muted);
    font: var(--text-xs) var(--font-mono);
  }
  .connector {
    width: 1px;
    height: 2.5rem;
    margin: auto;
    background: linear-gradient(var(--accent), var(--accent-line));
  }
  .architecture-columns {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .arch-node {
    padding: 1.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
  }
  .arch-node h3 {
    margin: 1rem 0 1.25rem;
    font-size: var(--text-2xl);
  }
  .arch-node p {
    font-size: var(--text-sm);
    line-height: 1.9;
  }
  .manager-grid,
  .scene-flow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .manager-grid span,
  .scene-flow span {
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--text-soft);
    font: var(--text-xs) var(--font-mono);
  }
  .diagram-caption {
    margin-top: 1.75rem;
    color: var(--muted);
    font-size: var(--text-sm);
    text-align: center;
  }
  .diagram-caption a {
    color: var(--accent);
  }
  .pipeline-title {
    margin: 3.5rem 0 1.5rem;
    font-size: var(--text-2xl);
  }
  .pipeline-note {
    margin-top: 1.25rem;
  }
  .section-divider {
    width: 100%;
    margin: 0;
    border: 0;
    border-top: 1px solid var(--border);
  }
  .technology-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(2rem, 1rem + 3vw, 3.5rem);
  }
  .technology-list > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
  }
  .technology-link {
    grid-column: 1/-1;
    justify-self: start;
    min-height: 2.75rem;
    max-width: 100%;
    gap: 0.5rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
  .technology-list strong {
    font: 600 clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem) var(--font-display);
    letter-spacing: -0.02em;
  }
  .technology-list .mono {
    color: var(--accent);
  }
  .technology-list p {
    grid-column: 1/-1;
    margin: 0;
    font-size: var(--text-sm);
  }
  .limits .notice {
    margin-block: 1.5rem;
  }
  .limits .text-link {
    margin-top: 0.5rem;
  }
  @media (max-width: 900px) {
    .system-row {
      grid-template-columns: 2rem minmax(0, 1fr) 1.25rem;
      grid-template-areas:
        'num title arrow'
        'num desc arrow'
        'num pill arrow';
      align-items: start;
      gap: 0.5rem 1rem;
    }
    .system-number {
      grid-area: num;
      padding-top: 0.3rem;
    }
    .system-row h3 {
      grid-area: title;
    }
    .system-row p {
      grid-area: desc;
    }
    .system-row .pill {
      grid-area: pill;
      margin-top: 0.25rem;
    }
    .system-row > span:last-child {
      grid-area: arrow;
      align-self: center;
    }
    .architecture-columns {
      gap: 1rem;
    }
    .arch-node {
      padding: 1.25rem;
    }
  }
  @media (max-width: 640px) {
    .about-layout,
    .limits {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }
    .architecture-columns {
      grid-template-columns: minmax(0, 1fr);
    }
    .diagram-caption {
      line-height: 1.8;
      text-align: left;
    }
    .technology-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
