---
import Docs from '../../layouts/Docs.astro';
import { getDocs } from '../../i18n/docs';
import { getLocale } from '../../i18n/locales';
const locale = getLocale(Astro.url.pathname);
const guideIcons: Record<string, string> = {
  introduccion:
    'M4 5h6a3 3 0 0 1 3 3v13a4 4 0 0 0-4-2H4V5Zm16 0h-5a2 2 0 0 0-2 2v14a4 4 0 0 1 4-2h3V5Z',
  instalacion: 'M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5',
  configuracion: 'M4 7h16M4 17h16M8 4v6M16 14v6',
  arquitectura: 'M9 3h6v5H9zM3 16h6v5H3zM15 16h6v5h-6zM12 8v4M6 16v-4h12v4',
  renderizado: 'm12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5',
  recursos: 'm12 3 9 5-9 5-9-5 9-5ZM3 8v10l9 5 9-5V8M12 13v10',
  escenas: 'M3 5h18v15H3zM3 10h18M7 5l3 5M14 5l3 5m-7 3 5 3-5 2v-5',
  'entrada-audio': 'M4 8h16v11H4zM7 12h4M9 10v4M16 12h1M18 15h1M12 8V4',
  problemas: 'M9 8V5h6v3M6 9h12v10H6zM3 11h3m12 0h3M3 17h3m12 0h3M9 12v4m6-4v4',
};
const docs = await getDocs(locale);
---

<Docs
  prose={false}
  title="Conoce tu motor."
  description="De la primera compilación al pipeline de renderizado. Guías basadas en el código real de Awesome Engine."
>
  <div class="docs-start">
    <span class="eyebrow">TU PRIMER PASO</span>
    <h2>Compila. Ejecuta. Explora.</h2>
    <p>Prepara CMake y un compilador C++20. Las dependencias se resuelven con FetchContent.</p>
    <a class="button primary" href="/docs/instalacion/">
      Guía de instalación <span>→</span>
    </a>
  </div>
  <label class="search-label" for="docs-search">
    Buscar una guía
  </label>
  <div class="search-box">
    <span aria-hidden="true">⌕</span>
    <input
      id="docs-search"
      type="search"
      placeholder="Escenas, audio, configuración…"
      autocomplete="off"
      aria-describedby="search-count"
    />
    <kbd aria-hidden="true">/</kbd>
  </div>
  <p class="search-count" id="search-count" role="status">
    {docs.length} guías disponibles
  </p>
  <div class="doc-grid">
    {docs.map((doc, i) => (
      <a
        class="doc-card"
        href={`/docs/${doc.slug}/`}
        data-doc-card
        data-search={`${doc.data.title} ${doc.data.description} ${doc.body}`}
      >
        <div class="doc-card-top">
          <span class="doc-icon" aria-hidden="true">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 26"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={guideIcons[doc.slug] || guideIcons.introduccion} />
            </svg>
          </span>
          <span class="doc-number" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
        </div>
        <span class="doc-category">{doc.data.category}</span>
        <h3>{doc.data.title}</h3>
        <p>{doc.data.description}</p>
        <span class="doc-card-action" aria-hidden="true">
          Explorar guía{' '}
          <span class="doc-arrow">
            <svg
              width="16"
              height="16"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 10h12m-5-5 5 5-5 5" />
            </svg>
          </span>
        </span>
      </a>
    ))}
  </div>
  <div class="empty-state" id="docs-empty" hidden>
    <h3>No encontramos esa guía.</h3>
    <p>Prueba con «renderizado», «recursos» o «escenas».</p>
  </div>
  <div class="notice">
    <strong>Documentación con contexto.</strong> La revisión pública de referencia es{' '}
    <code>5a6dfac</code>. Las integraciones locales pendientes se identifican por separado; no se
    presentan como una versión publicada.
  </div>
  <script>
    import { plural } from '../../i18n/client';
    const input = document.querySelector<HTMLInputElement>('#docs-search');
    const cards = [...document.querySelectorAll<HTMLElement>('[data-doc-card]')];
    const count = document.querySelector('#search-count');
    const empty = document.querySelector<HTMLElement>('#docs-empty');
    const normalize = (s: string) =>
      s
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase();
    function filter() {
      const q = normalize(input?.value.trim() || '');
      let found = 0;
      cards.forEach((c) => {
        c.hidden = !normalize(c.dataset.search || '').includes(q);
        if (!c.hidden) found++;
      });
      if (count) count.textContent = plural('guidesOne', 'guidesOther', found);
      if (empty) empty.hidden = found > 0;
    }
    input?.addEventListener('input', filter);
    // Apply any query typed or restored before the module finished loading.
    filter();
    window.addEventListener('pageshow', filter);
    document.addEventListener('keydown', (e) => {
      if (
        e.key === '/' &&
        !(e.target instanceof HTMLInputElement) &&
        !(e.target instanceof HTMLTextAreaElement)
      ) {
        e.preventDefault();
        input?.focus();
      }
    });
  </script>
</Docs>
<style>
  .docs-start {
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    margin-bottom: 36px;
  }
  .docs-start h2 {
    margin: 0 0 16px;
    font-size: 28px;
  }
  .docs-start p {
    font-size: 13px;
  }
  .docs-start .eyebrow {
    font-size: 9px;
  }
  .docs-start .button {
    text-decoration: none;
    color: var(--on-accent);
    font-size: 12px;
  }
  .search-label {
    display: block;
    font-size: 12px;
    color: var(--text);
    margin-bottom: 10px;
  }
  .search-box {
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 10px 14px;
    border-radius: 6px;
  }
  .search-box:focus-within {
    border-color: var(--accent);
  }
  .search-box > span {
    font-size: 25px;
  }
  .search-box input {
    background: none;
    border: 0;
    color: var(--text);
    width: 100%;
    min-width: 0;
    font-size: 13px;
    padding: 3px;
  }
  .search-box input:focus-visible {
    outline: 0;
  }
  .search-box kbd {
    border: 1px solid var(--border);
    padding: 0 7px;
    border-radius: 3px;
    font-size: 11px;
  }
  .search-count {
    font-size: 10px;
    margin: 8px 0 20px;
  }
  .doc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 32px;
  }
  .doc-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 26px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition:
      background 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }
  .doc-card:hover,
  .doc-card:focus-visible {
    background: color-mix(in srgb, var(--accent) 4%, var(--surface));
    border-color: color-mix(in srgb, var(--accent) 65%, var(--border));
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .doc-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 26px;
  }
  .doc-icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--border));
    border-radius: 11px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 7%, var(--surface));
  }
  .doc-number {
    font: 11px var(--font-mono);
    color: var(--muted);
  }
  .doc-category {
    font: 10px var(--font-mono);
    color: var(--accent);
    margin-bottom: 10px;
  }
  .doc-card h3 {
    font-size: 20px;
    line-height: 1.25;
    letter-spacing: -0.035em;
    margin: 0 0 12px;
  }
  .doc-card p {
    font-size: 13px;
    line-height: 1.75;
    margin: 0 0 24px;
    color: var(--muted);
  }
  .doc-card-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    font-size: 11px;
    font-weight: 500;
    color: var(--muted);
  }
  .doc-arrow {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--text);
    transition:
      color 200ms ease,
      background 200ms ease;
  }
  .doc-card:hover .doc-arrow,
  .doc-card:focus-visible .doc-arrow {
    background: var(--accent);
    color: var(--on-accent);
  }
  .doc-card:hover .doc-card-action,
  .doc-card:focus-visible .doc-card-action {
    color: var(--text);
  }
  .empty-state {
    margin-bottom: 28px;
  }
  .notice {
    font-size: 12px;
  }
  @media (max-width: 640px) {
    .doc-grid {
      grid-template-columns: 1fr;
    }
    .docs-start {
      padding: 22px;
    }
    .docs-start h2 {
      font-size: 25px;
    }
  }
</style>
