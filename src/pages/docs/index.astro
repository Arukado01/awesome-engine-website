---
import Docs from '../../layouts/Docs.astro';
import TestingSection from '../../components/TestingSection.astro';
import { getDocs } from '../../i18n/docs';
import { getLocale } from '../../i18n/locales';
const locale = getLocale(Astro.url.pathname);
const guideIcons: Record<string, string> = {
  introduccion:
    'M4 5h6a3 3 0 0 1 3 3v13a4 4 0 0 0-4-2H4V5Zm16 0h-5a2 2 0 0 0-2 2v14a4 4 0 0 1 4-2h3V5Z',
  instalacion: 'M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5',
  pruebas: 'M8 3h8m-6 0v7l-5 8a2 2 0 0 0 2 3h10a2 2 0 0 0 2-3l-5-8V3M8 15h8',
  configuracion: 'M4 7h16M4 17h16M8 4v6M16 14v6',
  arquitectura: 'M9 3h6v5H9zM3 16h6v5H3zM15 16h6v5h-6zM12 8v4M6 16v-4h12v4',
  renderizado: 'm12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5',
  recursos: 'm12 3 9 5-9 5-9-5 9-5ZM3 8v10l9 5 9-5V8M12 13v10',
  escenas: 'M3 5h18v15H3zM3 10h18M7 5l3 5M14 5l3 5m-7 3 5 3-5 2v-5',
  'entrada-audio': 'M4 8h16v11H4zM7 12h4M9 10v4M16 12h1M18 15h1M12 8V4',
  problemas: 'M9 8V5h6v3M6 9h12v10H6zM3 11h3m12 0h3M3 17h3m12 0h3M9 12v4m6-4v4',
};
const docs = await getDocs(locale);
---

<Docs
  prose={false}
  title="Conoce tu motor."
  description="De la primera compilación al pipeline de renderizado. Guías basadas en el código real de Awesome Engine."
>
  <div class="docs-start">
    <span class="eyebrow">TU PRIMER PASO</span>
    <h2>Compila. Ejecuta. Explora.</h2>
    <p>Prepara CMake y un compilador C++20. Las dependencias se resuelven con FetchContent.</p>
    <a class="button primary" href="/docs/instalacion/">
      Guía de instalación <span>→</span>
    </a>
  </div>
  <div class="docs-testing">
    <TestingSection />
  </div>
  <label class="search-label" for="docs-search">
    Buscar una guía
  </label>
  <div class="search-box">
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="10.5" cy="10.5" r="6.5" />
      <path d="m16 16 5 5" />
    </svg>
    <input
      id="docs-search"
      type="search"
      placeholder="Escenas, audio, configuración…"
      autocomplete="off"
      aria-describedby="search-count"
    />
    <kbd aria-hidden="true">/</kbd>
  </div>
  <p class="search-count" id="search-count" role="status">
    {docs.length} guías disponibles
  </p>
  <div class="doc-grid">
    {docs.map((doc, i) => (
      <a
        class="doc-card"
        href={`/docs/${doc.slug}/`}
        data-doc-card
        data-search={`${doc.data.title} ${doc.data.description} ${doc.body}`}
      >
        <div class="doc-card-top">
          <span class="doc-icon" aria-hidden="true">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 26"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={guideIcons[doc.slug] || guideIcons.introduccion} />
            </svg>
          </span>
          <span class="doc-number" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
        </div>
        <span class="doc-category">{doc.data.category}</span>
        <h3>{doc.data.title}</h3>
        <p>{doc.data.description}</p>
        <span class="doc-card-action" aria-hidden="true">
          Explorar guía{' '}
          <span class="doc-arrow">
            <svg
              width="16"
              height="16"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 10h12m-5-5 5 5-5 5" />
            </svg>
          </span>
        </span>
      </a>
    ))}
  </div>
  <div class="empty-state" id="docs-empty" hidden>
    <h3>No encontramos esa guía.</h3>
    <p>Prueba con «renderizado», «recursos» o «escenas».</p>
  </div>
  <div class="notice">
    <strong>Documentación con contexto.</strong> La revisión pública de referencia es{' '}
    <code>61a3244</code>. Las guías enlazan a los sistemas disponibles en esa revisión.
  </div>
  <script>
    import { plural } from '../../i18n/client';
    const input = document.querySelector<HTMLInputElement>('#docs-search');
    const cards = [...document.querySelectorAll<HTMLElement>('[data-doc-card]')];
    const count = document.querySelector('#search-count');
    const empty = document.querySelector<HTMLElement>('#docs-empty');
    const normalize = (s: string) =>
      s
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase();
    function filter() {
      const q = normalize(input?.value.trim() || '');
      let found = 0;
      cards.forEach((c) => {
        c.hidden = !normalize(c.dataset.search || '').includes(q);
        if (!c.hidden) found++;
      });
      if (count) count.textContent = plural('guidesOne', 'guidesOther', found);
      if (empty) empty.hidden = found > 0;
    }
    input?.addEventListener('input', filter);
    // Apply any query typed or restored before the module finished loading.
    filter();
    window.addEventListener('pageshow', filter);
    document.addEventListener('keydown', (e) => {
      if (
        e.key === '/' &&
        !(e.target instanceof HTMLInputElement) &&
        !(e.target instanceof HTMLTextAreaElement)
      ) {
        e.preventDefault();
        input?.focus();
      }
    });
  </script>
</Docs>
<style>
  .docs-start {
    margin-bottom: 2rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, var(--accent-soft), transparent 60%),
      var(--surface);
  }
  .docs-start .eyebrow {
    margin-bottom: 1rem;
  }
  .docs-start h2 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.625rem, 1.35rem + 1vw, 2.125rem);
  }
  .docs-start p {
    max-width: 36rem;
    margin-bottom: 1.5rem;
  }
  .docs-start .button {
    color: var(--on-accent);
    text-decoration: none;
  }
  .docs-testing {
    margin-bottom: 2.5rem;
  }
  .search-label {
    display: block;
    margin-bottom: 0.625rem;
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .search-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.25rem;
    padding: 0 0.875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--muted);
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
  }
  .search-box:hover {
    border-color: var(--border-strong);
  }
  .search-box:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }
  .search-box input {
    width: 100%;
    min-width: 0;
    padding: 0.625rem 0.25rem;
    border: 0;
    background: none;
    color: var(--text);
    font-size: var(--text-base);
  }
  .search-box input:focus-visible {
    outline: 0;
  }
  .search-box input::placeholder {
    color: var(--muted);
    opacity: 1;
  }
  .search-box kbd {
    padding: 0.0625rem 0.4375rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    font: var(--text-xs) var(--font-mono);
  }
  .search-count {
    margin: 0.625rem 0 1.25rem;
    font-size: var(--text-sm);
  }
  .doc-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  .doc-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color 200ms ease,
      box-shadow 200ms ease,
      transform 250ms var(--ease-out);
  }
  .doc-card:hover,
  .doc-card:focus-visible {
    border-color: var(--accent-line);
    box-shadow: var(--shadow-hover);
  }
  .doc-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .doc-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--border));
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .doc-number {
    color: var(--muted);
    font: var(--text-xs) var(--font-mono);
  }
  .doc-category {
    margin-bottom: 0.5rem;
    color: var(--accent);
    font: 500 var(--text-2xs) var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .doc-card h3 {
    margin: 0 0 0.625rem;
    font-size: var(--text-xl);
    line-height: 1.25;
    letter-spacing: -0.025em;
  }
  .doc-card p {
    margin: 0 0 1.5rem;
    color: var(--muted);
    font-size: var(--text-md);
    line-height: 1.65;
  }
  .doc-card-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border-soft);
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .doc-arrow {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--text);
    transition:
      color 200ms ease,
      background 200ms ease,
      transform var(--duration) var(--ease-out);
  }
  .doc-card:hover .doc-arrow,
  .doc-card:focus-visible .doc-arrow {
    background: var(--accent);
    color: var(--on-accent);
    transform: translateX(2px);
  }
  .doc-card:hover .doc-card-action,
  .doc-card:focus-visible .doc-card-action {
    color: var(--text);
  }
  .empty-state {
    margin-bottom: 1.75rem;
  }
  .notice {
    font-size: var(--text-sm);
  }
  @media (max-width: 640px) {
    .doc-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .docs-start {
      padding: 1.375rem;
    }
  }
</style>
