---
const steps = [
  ['01', 'Escena', 'Scene::Render()'],
  ['02', 'RenderTexture', 'Dibujo fuera de pantalla'],
  ['03', 'Bloom + Monitor', 'Posprocesado GLSL'],
  ['04', 'Ventana', 'GUI + cursor + display'],
];
---

<div
  class="pipeline"
  aria-label="Flujo de renderizado: escena, textura intermedia, bloom y monitor, ventana con interfaz y cursor"
>
  {steps.map(([n, title, detail]) => (
    <div class="pipeline-step">
      <span class="pipeline-number">{n}</span>
      <strong>{title}</strong>
      <span>{detail}</span>
    </div>
  ))}
</div>
<style>
  .pipeline {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
  }
  .pipeline-step {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    position: relative;
  }
  .pipeline-step:not(:last-child) {
    border-right: 1px solid var(--border);
  }
  .pipeline-step:not(:last-child):after {
    content: '→';
    position: absolute;
    right: -11px;
    top: 50%;
    background: var(--surface);
    color: var(--accent);
    padding: 0 4px;
    z-index: 1;
  }
  .pipeline-number {
    font: 11px var(--font-mono);
    color: var(--accent);
    margin-bottom: 16px;
  }
  .pipeline-step strong {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 500;
  }
  .pipeline-step > span:last-child {
    font-size: 11px;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .pipeline {
      grid-template-columns: repeat(2, 1fr);
    }
    .pipeline-step:nth-child(2) {
      border-right: 0;
    }
    .pipeline-step:nth-child(2):after {
      display: none;
    }
    .pipeline-step:nth-child(-n + 2) {
      border-bottom: 1px solid var(--border);
    }
  }
  @media (max-width: 450px) {
    .pipeline-step {
      padding: 20px 16px;
    }
    .pipeline-step strong {
      font-size: 15px;
    }
    .pipeline-step > span:last-child {
      font-size: 10px;
    }
  }
</style>
