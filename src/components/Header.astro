---
import Logo from './Logo.astro';
import LanguagePicker from './LanguagePicker.astro';
import { withoutLocale } from '../i18n/locales';
const currentPath = withoutLocale(Astro.url.pathname);
import '../styles/theme-control.css';
const themes = [
  {
    value: 'system',
    label: 'Sistema',
    detail: 'Como tu dispositivo',
    path: 'M3 4h18v12H3z M8 20h8 M12 16v4',
  },
  {
    value: 'dark',
    label: 'Oscuro',
    detail: 'Para crear sin distracciones',
    path: 'M20.9 13a9 9 0 0 1-9.9-9.9A9 9 0 1 0 20.9 13Z',
  },
  {
    value: 'light',
    label: 'Claro',
    detail: 'Un poco más de luz',
    path: 'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8 M12 2v2 M12 20v2 M2 12h2 M20 12h2 M5 5l2 2 M17 17l2 2 M5 19l2-2 M17 7l2-2',
  },
];
const links = [
  { href: '/motor/', label: 'El motor' },
  { href: '/showcase/', label: 'Showcase' },
  { href: '/docs/', label: 'Documentación' },
  { href: '/evolucion/', label: 'Evolución' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Awesome Engine, inicio">
      <Logo />
      <span>
        AWESOME <span class="brand-sub">ENGINE</span>
      </span>
    </a>
    <nav class="main-nav" id="main-nav" aria-label="Navegación principal">
      {links.map((l) => (
        <a href={l.href} aria-current={currentPath.startsWith(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
      <a class="mobile-contact" href="/contacto/">
        Contacto
      </a>
    </nav>
    <div class="header-actions">
      <LanguagePicker />
      <div class="theme-picker" id="theme-picker" hidden>
        <button
          class="theme-trigger"
          id="theme-trigger"
          type="button"
          aria-expanded="false"
          aria-controls="theme-panel"
        >
          {themes.map((t) => (
            <svg
              data-theme-icon={t.value}
              data-active={String(t.value === 'system')}
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={t.path} />
            </svg>
          ))}
          <span class="sr-only">Cambiar tema: </span>
          <span class="theme-current">Sistema</span>
          <svg
            class="theme-chevron"
            width="12"
            height="12"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="m4 6 4 4 4-4" />
          </svg>
        </button>
        <div class="theme-panel" id="theme-panel" hidden>
          <span class="theme-panel-title" aria-hidden="true">
            TU ESPACIO, TU ESTILO
          </span>
          <div role="radiogroup" aria-label="Tema visual" class="theme-options">
            {themes.map((t) => (
              <label class="theme-option">
                <input
                  class="theme-radio"
                  type="radio"
                  name="theme"
                  value={t.value}
                  checked={t.value === 'system'}
                  aria-label={t.label}
                  aria-describedby={'theme-description-' + t.value}
                />
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={t.path} />
                </svg>
                <span class="theme-option-copy">
                  <span>{t.label}</span>
                  <small id={'theme-description-' + t.value}>{t.detail}</small>
                </span>
                <svg
                  class="theme-check"
                  width="16"
                  height="16"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  aria-hidden="true"
                >
                  <path d="m4 10 4 4 8-8" />
                </svg>
              </label>
            ))}
          </div>
        </div>
      </div>
      <a
        class="github-link"
        href="https://github.com/Arukado01/AwesomeEngine"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Código de Awesome Engine en GitHub (nueva pestaña)"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .8a11.5 11.5 0 0 0-3.64 22.4c.57.1.78-.25.78-.55v-2.02c-3.2.69-3.87-1.35-3.87-1.35-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.95.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.24 2.75.12 3.04.74.8 1.18 1.83 1.18 3.08 0 4.42-2.69 5.39-5.25 5.68.42.36.78 1.05.78 2.13v3.03c0 .31.21.66.79.55A11.5 11.5 0 0 0 12 .8Z" />
        </svg>
      </a>
      <button
        class="menu-toggle"
        aria-controls="main-nav"
        aria-expanded="false"
        aria-label="Abrir navegación"
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>
