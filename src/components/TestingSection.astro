---
const { variant = 'panel' } = Astro.props;
---

{
  variant === 'card' ? (
    <div class="testing-feature" id="pruebas" aria-labelledby="testing-title">
      <a class="feature testing-card" href="/docs/pruebas/">
        <div class="feature-top">
          <span class="mono">04 — CALIDAD</span>
          <span class="pill live">Implementado</span>
        </div>
        <div class="test-visual" aria-hidden="true" data-no-translate>
          <span class="test-caption">ctest → 100% passed</span>
          <div class="test-chips">
            <span><i>✓</i> render</span>
            <span><i>✓</i> scenes</span>
            <span><i>✓</i> resources</span>
            <span><i>✓</i> input</span>
            <span><i>✓</i> audio</span>
            <span><i>✓</i> animation</span>
            <span><i>✓</i> collision</span>
            <span><i>✓</i> particles</span>
            <span><i>✓</i> time</span>
            <span><i>✓</i> save</span>
          </div>
        </div>
        <div class="feature-bottom">
          <div>
            <h3 id="testing-title">Pruebas del motor</h3>
            <p>Consulta qué cubre cada suite y cómo ejecutar las pruebas con CMake y CTest.</p>
          </div>
          <span class="feature-arrow">↗</span>
        </div>
      </a>
    </div>
  ) : (
    <section class="testing-section" id="pruebas" aria-labelledby="testing-title">
      <div class="testing-panel">
        <span class="testing-eyebrow">Calidad verificable</span>
        <h2 id="testing-title">Pruebas del motor</h2>
        <p>Consulta qué cubre cada suite y cómo ejecutar las pruebas con CMake y CTest.</p>
        <a class="button" href="/docs/pruebas/">
          Ver guía de pruebas <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  )
}

<style>
  .testing-feature {
    margin-top: 25px;
  }
  .testing-card {
    width: 100%;
  }
  .testing-card h3 {
    margin: 0 0 12px;
  }
  .test-visual {
    display: grid;
    gap: 10px;
    justify-items: start;
    margin-block: 22px;
  }
  .test-caption {
    font: 10px var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .test-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .test-chips span {
    font: 10px var(--font-mono);
    background: var(--surface-2);
    border: 1px solid var(--border);
    padding: 7px 10px;
    border-radius: 3px;
    color: var(--muted);
  }
  .test-chips i {
    font-style: normal;
    color: var(--mint);
  }
  .testing-panel {
    display: grid;
    justify-items: start;
    gap: 16px;
    padding: clamp(24px, 4vw, 40px);
    background: var(--surface);
    border: 1px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 12px;
  }
  .testing-eyebrow {
    font: 500 9px var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .testing-panel h2 {
    margin: 0;
    font: 500 24px var(--font-display);
  }
  .testing-panel p {
    margin: 0;
    font-size: 12px;
    line-height: 2;
    max-width: 62ch;
  }
  .testing-panel .button {
    margin-top: 8px;
    max-width: 100%;
    text-decoration: none;
  }
</style>
