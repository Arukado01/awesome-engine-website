---
const { variant = 'panel' } = Astro.props;
const tests = [
  { name: 'core.collision', href: '/docs/pruebas/#colisiones-2d' },
  { name: 'core.collision.detects_failure', href: '/docs/pruebas/#colisiones-2d' },
  { name: 'core.sprite_animator', href: '/docs/pruebas/#animación-de-sprites' },
];
---

{
  variant === 'card' ? (
    <div class="testing-feature" id="pruebas" aria-labelledby="testing-title">
      <a class="feature testing-card" href="/docs/pruebas/">
        <div class="feature-top">
          <span class="mono">04 — CALIDAD</span>
          <span class="pill live">Implementado</span>
        </div>
        <div class="collision-visual" aria-hidden="true">
          <div class="collision-stage">
            <span class="cbox box-a"></span>
            <span class="cbox box-b"></span>
            <span class="cbox box-hit"></span>
          </div>
          <span class="collision-caption">AABB → INTERSECCIÓN → RESOLUCIÓN</span>
        </div>
        <div class="feature-bottom">
          <div>
            <h3 id="testing-title">Pruebas del motor</h3>
            <p>Consulta qué cubre cada suite y cómo ejecutar las pruebas con CMake y CTest.</p>
          </div>
          <span class="feature-arrow">↗</span>
        </div>
      </a>
    </div>
  ) : (
    <section class="testing-section" id="pruebas" aria-labelledby="testing-title">
      <div class="testing-panel">
        <span class="testing-eyebrow">Calidad verificable</span>
        <h2 id="testing-title">Pruebas del motor</h2>
        <p>Consulta qué cubre cada suite y cómo ejecutar las pruebas con CMake y CTest.</p>
        <div class="test-chips">
          {tests.map((test) => (
            <a class="test-chip" href={test.href}>
              <code>{test.name}</code>
            </a>
          ))}
        </div>
        <a class="button" href="/docs/pruebas/">
          Ver guía de pruebas <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  )
}

<style>
  .testing-feature {
    margin-top: 25px;
  }
  .testing-card {
    width: 100%;
  }
  .testing-card h3 {
    margin: 0 0 12px;
  }
  .collision-visual {
    display: grid;
    gap: 14px;
    margin-block: 20px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background-color: color-mix(in srgb, var(--surface-2) 45%, transparent);
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 26px 26px;
    overflow: hidden;
  }
  .collision-stage {
    position: relative;
    height: 88px;
    --sweep: 120px;
  }
  .cbox {
    position: absolute;
    inset-block: 12px;
    width: 120px;
    border: 1px solid var(--accent);
    border-radius: 2px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .box-a {
    left: 50%;
    margin-left: -220px;
  }
  .box-b {
    right: 50%;
    margin-right: -220px;
    border-color: var(--mint);
    background: color-mix(in srgb, var(--mint) 8%, transparent);
  }
  .box-hit {
    inset-block: 12px;
    left: 50%;
    width: 44px;
    translate: -50% 0;
    border: 1px dashed var(--accent);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    opacity: 0;
  }
  .collision-caption {
    font: 8px var(--font-mono);
    letter-spacing: 0.15em;
    color: var(--muted);
  }
  @media (max-width: 700px) {
    .cbox {
      width: 90px;
      inset-block: 20px;
    }
    .box-a {
      margin-left: -140px;
    }
    .box-b {
      margin-right: -140px;
    }
    .collision-stage {
      --sweep: 55px;
    }
    .box-hit {
      width: 30px;
    }
  }
  .testing-panel {
    display: grid;
    justify-items: start;
    gap: 16px;
    padding: clamp(24px, 4vw, 40px);
    background: var(--surface);
    border: 1px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 12px;
  }
  .testing-eyebrow {
    font: 500 9px var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .testing-panel h2 {
    margin: 0;
    font: 500 24px var(--font-display);
  }
  .testing-panel p {
    margin: 0;
    font-size: 12px;
    line-height: 2;
    max-width: 62ch;
  }
  .test-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .test-chip {
    font: 10px var(--font-mono);
    background: var(--surface-2);
    border: 1px solid var(--border);
    padding: 7px 10px;
    border-radius: 3px;
    color: var(--muted);
    text-decoration: none;
  }
  .test-chip:hover {
    color: var(--text);
    border-color: var(--accent);
  }
  .test-chip code {
    font: inherit;
    color: inherit;
  }
  .testing-panel .button {
    margin-top: 8px;
    max-width: 100%;
    text-decoration: none;
  }
</style>
