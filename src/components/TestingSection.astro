---
const { variant = 'panel' } = Astro.props;
const suites = [
  { name: 'Colisiones 2D', href: '/docs/pruebas/#colisiones-2d' },
  { name: 'Animación de sprites', href: '/docs/pruebas/#animación-de-sprites' },
];
---

{
  variant === 'card' ? (
    <div class="testing-feature" id="pruebas" aria-labelledby="testing-title">
      <a class="feature testing-card" href="/docs/pruebas/">
        <div class="feature-top">
          <span class="mono">04 — CALIDAD</span>
          <span class="pill live">Implementado</span>
        </div>
        <div class="collision-visual" aria-hidden="true">
          <div class="collision-stage">
            <span class="cbox box-a"></span>
            <span class="cbox box-b"></span>
            <span class="cbox box-hit"></span>
          </div>
          <span class="collision-caption">AABB → INTERSECCIÓN → RESOLUCIÓN</span>
        </div>
        <div class="feature-bottom">
          <div>
            <h3 id="testing-title">Pruebas del motor</h3>
            <p>Consulta qué cubre cada suite y cómo ejecutar las pruebas con CMake y CTest.</p>
          </div>
          <span class="feature-arrow">↗</span>
        </div>
      </a>
    </div>
  ) : (
    <section class="testing-section" id="pruebas" aria-labelledby="testing-title">
      <div class="testing-panel">
        <span class="testing-eyebrow">Calidad verificable</span>
        <h2 id="testing-title">Pruebas del motor</h2>
        <p>Consulta qué cubre cada suite y cómo ejecutar las pruebas con CMake y CTest.</p>
        <div class="test-chips">
          {suites.map((suite) => (
            <a class="test-chip" href={suite.href}>
              {suite.name}
            </a>
          ))}
        </div>
        <a class="button" href="/docs/pruebas/">
          Ver guía de pruebas <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  )
}

<style>
  /* Home card: one wide tile of the feature grid. */
  .testing-feature {
    container-type: inline-size;
  }
  .testing-card {
    width: 100%;
  }
  .testing-card h3 {
    margin: 0 0 0.625rem;
  }
  .collision-visual {
    display: grid;
    align-content: center;
    gap: 0.875rem;
    margin-block: 1.25rem;
    padding: 1rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: color-mix(in srgb, var(--surface-2) 45%, transparent);
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 26px 26px;
  }
  /* Proportional stage: the boxes meet in the middle at any width. */
  .collision-stage {
    --sweep: 62%;
    position: relative;
    height: 88px;
  }
  .cbox {
    position: absolute;
    inset-block: 12px;
    width: 28%;
    border: 1px solid var(--accent);
    border-radius: 2px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .box-a {
    left: 8%;
  }
  .box-b {
    right: 8%;
    border-color: var(--mint);
    background: color-mix(in srgb, var(--mint) 8%, transparent);
  }
  .box-hit {
    left: 50%;
    width: 7%;
    translate: -50% 0;
    border: 1px dashed var(--accent);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    opacity: 0;
  }
  .collision-caption {
    color: var(--muted);
    font: var(--text-2xs) var(--font-mono);
    letter-spacing: 0.15em;
  }
  @container (min-width: 46rem) {
    .testing-card {
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'top visual'
        'bottom visual';
      column-gap: clamp(1.5rem, 4cqi, 3rem);
    }
    .testing-card > .feature-top {
      grid-area: top;
    }
    .testing-card > .collision-visual {
      grid-area: visual;
      margin: 0;
    }
    .testing-card > .feature-bottom {
      grid-area: bottom;
      align-self: end;
      margin-top: 2rem;
    }
  }

  /* Panel used on the engine page and the documentation index. */
  .testing-section {
    container-type: inline-size;
  }
  .testing-panel {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--accent-soft), transparent 55%), var(--surface);
  }
  .testing-eyebrow {
    color: var(--accent);
    font: 500 var(--text-2xs) var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .testing-panel h2 {
    margin: 0;
    font: 600 clamp(1.5rem, 1.3rem + 0.8vw, 1.875rem) / 1.15 var(--font-display);
    letter-spacing: -0.03em;
  }
  .testing-panel p {
    max-width: 62ch;
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.7;
  }
  .test-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .test-chip {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--text-soft);
    font: var(--text-xs) var(--font-mono);
    text-decoration: none;
  }
  .test-chip:hover {
    border-color: var(--accent-line);
    color: var(--text);
  }
  .test-chip code {
    font: inherit;
    color: inherit;
  }
  .testing-panel .button {
    max-width: 100%;
    margin-top: 0.25rem;
    text-decoration: none;
  }
  @container (min-width: 46rem) {
    .testing-panel {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 3rem;
    }
    .testing-eyebrow {
      grid-area: 1 / 1;
    }
    .testing-panel h2 {
      grid-area: 2 / 1;
    }
    .testing-panel p {
      grid-area: 3 / 1;
    }
    .test-chips {
      grid-area: 1 / 2 / 3 / 3;
      justify-self: end;
      justify-content: flex-end;
    }
    .testing-panel .button {
      grid-area: 3 / 2;
      justify-self: end;
      align-self: end;
      margin-top: 0;
    }
  }
</style>
