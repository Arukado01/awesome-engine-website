---
import { getLocale, localeInfo, locales, localizedPath } from '../i18n/locales';
import '../styles/language-picker.css';
const locale = getLocale(Astro.url.pathname);
---

<details class="language-picker" id="language-picker">
  <summary
    class="language-trigger"
    aria-labelledby="language-action language-code"
    aria-describedby="language-current"
    title="Idioma"
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3a18 18 0 0 1 0 18 18 18 0 0 1 0-18Z" />
    </svg>
    <span id="language-action" class="sr-only">
      Elegir idioma
    </span>
    <span id="language-code" data-no-translate>
      {locale.toUpperCase()}
    </span>
    <svg
      class="language-chevron"
      width="12"
      height="12"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path d="m4 6 4 4 4-4" />
    </svg>
  </summary>
  <span id="language-current" class="sr-only" data-no-translate lang={localeInfo[locale].html}>
    {localeInfo[locale].name}
  </span>
  <div class="language-panel">
    <label class="sr-only" for="language-search">
      Buscar idioma
    </label>
    <input
      id="language-search"
      type="search"
      placeholder="Buscar idioma…"
      autocomplete="off"
      spellcheck="false"
    />
    <nav aria-label="Idioma">
      {locales.map((code) => (
        <a
          href={localizedPath(Astro.url.pathname, code)}
          data-locale-link={code}
          data-language-search={localeInfo[code].search + ' ' + localeInfo[code].name}
          hreflang={localeInfo[code].html}
          lang={localeInfo[code].html}
          aria-current={code === locale ? 'true' : undefined}
        >
          <span data-no-translate>{localeInfo[code].name}</span>
          <span class="language-code" data-no-translate>
            {code === locale ? '✓' : code.toUpperCase()}
          </span>
        </a>
      ))}
    </nav>
    <p id="language-empty" role="status" hidden>
      No se encontraron idiomas.
    </p>
  </div>
</details>
<script>
  import '../scripts/language-picker';
</script>
