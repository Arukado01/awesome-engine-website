---
import Base from './Base.astro';
import { getDocs } from '../i18n/docs';
import { getLocale, withoutLocale } from '../i18n/locales';
import { translate } from '../i18n/server';
const locale = getLocale(Astro.url.pathname);
interface Props {
  title: string;
  description: string;
  prose?: boolean;
  headings?: { depth: number; slug: string; text: string }[];
}
const { title, description, headings = [], prose = true } = Astro.props;
const docs = await getDocs(locale);
const categories = [...new Set(docs.map((d) => d.data.category))];
---

<Base
  title={`${translate(locale, title)} — ${translate(locale, 'Documentación')}`}
  description={description}
>
  <div class:list={['container', 'docs-layout', { 'has-toc': headings.length > 0 }]}>
    <aside class="docs-sidebar">
      <a href="/docs/" class="docs-label">
        DOCUMENTACIÓN <span>↗</span>
      </a>
      <details class="docs-nav" open>
        <summary>
          Explorar documentación <span>⌄</span>
        </summary>
        <nav aria-label="Documentación técnica">
          {categories.map((category) => (
            <div class="docs-nav-group">
              <span>{category}</span>
              {docs
                .filter((d) => d.data.category === category)
                .map((doc) => (
                  <a
                    href={`/docs/${doc.slug}/`}
                    aria-current={
                      withoutLocale(Astro.url.pathname) === `/docs/${doc.slug}/`
                        ? 'page'
                        : undefined
                    }
                  >
                    {doc.data.title}
                  </a>
                ))}
            </div>
          ))}
          <a class="source-nav" href="https://github.com/Arukado01/AwesomeEngine">
            Código en GitHub ↗
          </a>
        </nav>
      </details>
      <div class="docs-version">
        <span class="status-dot"></span> Referencia: 61a3244
        <br />
        <small>25 de noviembre de 2026</small>
      </div>
    </aside>
    <article class="docs-article">
      <div class="breadcrumb">
        <a href="/">Inicio</a>
        <span>/</span>
        <a href="/docs/">Documentación</a>
      </div>
      <header class="doc-header">
        <span class="eyebrow">AWESOME ENGINE / GUÍA TÉCNICA</span>
        <h1>{title}</h1>
        <p>{description}</p>
      </header>
      {headings.some((heading) => heading.depth === 2) && (
        <details class="doc-toc-mobile">
          <summary>En esta página</summary>
          <nav aria-label="Índice de esta página">
            {headings
              .filter((heading) => heading.depth === 2)
              .map((heading) => (
                <a href={`#${heading.slug}`}>{heading.text}</a>
              ))}
          </nav>
        </details>
      )}
      <div class={prose ? 'prose' : 'docs-directory'}>
        <slot />
      </div>
      <div class="doc-bottom">
        <span>Basado en código fuente verificado.</span>
        <a href="/contacto/">¿Encontraste un problema? →</a>
      </div>
    </article>
    {headings.length > 0 && (
      <aside class="doc-toc">
        <span>EN ESTA PÁGINA</span>
        <nav aria-label="Índice de esta página">
          {headings
            .filter((h) => h.depth === 2)
            .map((h) => (
              <a href={`#${h.slug}`}>{h.text}</a>
            ))}
        </nav>
        <a class="back-top" href="#main">
          Volver arriba ↑
        </a>
      </aside>
    )}
  </div>
  <script>
    const nav = document.querySelector<HTMLDetailsElement>('.docs-nav');
    const mq = window.matchMedia('(max-width: 900px)');
    function syncNav() {
      if (nav) nav.open = !mq.matches;
    }
    syncNav();
    mq.addEventListener('change', syncNav);
  </script>
</Base>
<style>
  .docs-layout {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 3vw, 4rem);
    min-height: 75vh;
  }
  .docs-layout.has-toc {
    grid-template-columns: 15rem minmax(0, 1fr) 12.5rem;
  }
  .docs-sidebar {
    position: sticky;
    top: calc(var(--header-h) + 1px);
    align-self: start;
    max-height: calc(100vh - var(--header-h) - 1px);
    overflow: auto;
    padding: 2.5rem 1.5rem 2.5rem 0;
    border-right: 1px solid var(--border);
    scrollbar-width: thin;
  }
  .docs-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.75rem;
    color: var(--accent);
    font: 500 var(--text-xs) var(--font-mono);
    letter-spacing: 0.1em;
  }
  .docs-label:hover {
    color: var(--text);
  }
  .docs-nav summary {
    display: none;
  }
  .docs-nav-group {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin-bottom: 1.5rem;
  }
  .docs-nav-group > span {
    margin: 0 0 0.5rem 0.75rem;
    color: var(--muted);
    font: 500 var(--text-2xs) var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .docs-nav-group a {
    padding: 0.4375rem 0.75rem;
    border-radius: var(--radius);
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.45;
  }
  .docs-nav-group a:hover {
    background: var(--surface);
    color: var(--text);
  }
  .docs-nav-group a[aria-current='page'] {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 500;
  }
  .source-nav {
    display: inline-block;
    margin-left: 0.75rem;
    color: var(--accent);
    font-size: var(--text-sm);
  }
  .source-nav:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .docs-version {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font: var(--text-xs) / 1.9 var(--font-mono);
  }
  .docs-version small {
    font: var(--text-xs) var(--font-mono);
  }
  .docs-article {
    min-width: 0;
    padding-block: 2.5rem 5rem;
  }
  .doc-header {
    margin-bottom: 2.25rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  .doc-header .eyebrow {
    margin-bottom: 1rem;
  }
  .doc-header h1 {
    margin-bottom: 1rem;
    font-size: clamp(2.125rem, 1.5rem + 2.4vw, 3.25rem);
  }
  .doc-header p {
    max-width: 42rem;
    font-size: var(--text-lead);
    line-height: 1.65;
  }
  .doc-toc-mobile {
    display: none;
    margin-bottom: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .doc-toc-mobile summary {
    padding: 0.875rem 1rem;
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .doc-toc-mobile summary::marker {
    color: var(--accent);
  }
  .doc-toc-mobile nav {
    display: grid;
    gap: 0.125rem;
    padding: 0.75rem 1rem 1rem;
    border-top: 1px solid var(--border);
  }
  .doc-toc-mobile nav a {
    padding: 0.375rem 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .doc-toc-mobile nav a:hover {
    color: var(--accent);
  }
  .doc-toc {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    align-self: start;
    margin-top: 5.75rem;
  }
  .doc-toc > span {
    color: var(--muted);
    font: 500 var(--text-2xs) var(--font-mono);
    letter-spacing: 0.12em;
  }
  .doc-toc nav {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin-top: 1rem;
    border-left: 1px solid var(--border);
  }
  .doc-toc nav a {
    margin-left: -1px;
    padding: 0.3125rem 0 0.3125rem 0.875rem;
    border-left: 1px solid transparent;
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .doc-toc nav a:hover {
    border-left-color: var(--accent);
    color: var(--text);
  }
  .back-top {
    display: inline-block;
    margin-top: 1.5rem;
    color: var(--accent);
    font-size: var(--text-xs);
  }
  .doc-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .doc-bottom a {
    color: var(--accent);
    font-weight: 500;
  }
  .doc-bottom a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  @media (max-width: 1100px) {
    .docs-layout,
    .docs-layout.has-toc {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 2.25rem;
    }
    .doc-toc {
      display: none;
    }
    .doc-toc-mobile {
      display: block;
    }
  }
  @media (max-width: 900px) {
    .docs-layout {
      display: block;
    }
    .docs-sidebar {
      position: static;
      max-height: none;
      padding: 1.5rem 0;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
    .docs-label {
      margin-bottom: 1rem;
    }
    .docs-nav summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 3rem;
      padding: 0.75rem 1rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--surface);
      font-size: var(--text-sm);
      font-weight: 500;
      list-style: none;
    }
    .docs-nav summary::-webkit-details-marker {
      display: none;
    }
    .docs-nav summary span {
      color: var(--accent);
      transition: transform var(--duration) var(--ease-out);
    }
    .docs-nav[open] summary span {
      transform: rotate(180deg);
    }
    .docs-nav[open] nav {
      padding-top: 1.5rem;
    }
    .docs-version {
      margin-top: 1rem;
      padding-top: 0;
      border-top: 0;
    }
    .docs-article {
      padding-top: 2rem;
    }
  }
  @media (max-width: 640px) {
    .doc-bottom {
      flex-direction: column;
    }
  }
</style>
