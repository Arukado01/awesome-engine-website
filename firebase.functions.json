{
  "hosting": {
    "site": "awesome-engine-web-arukado",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "headers": [
          {
            "value": "nosniff",
            "key": "X-Content-Type-Options"
          },
          {
            "value": "DENY",
            "key": "X-Frame-Options"
          },
          {
            "value": "strict-origin-when-cross-origin",
            "key": "Referrer-Policy"
          },
          {
            "value": "camera=(), microphone=(), geolocation=()",
            "key": "Permissions-Policy"
          },
          {
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'",
            "key": "Content-Security-Policy"
          }
        ],
        "source": "**"
      },
      {
        "headers": [
          {
            "value": "public, max-age=31536000, immutable",
            "key": "Cache-Control"
          }
        ],
        "source": "/_astro/**"
      },
      {
        "headers": [
          {
            "value": "public, max-age=86400",
            "key": "Cache-Control"
          }
        ],
        "source": "/images/**"
      },
      {
        "headers": [
          {
            "value": "no-store, max-age=0",
            "key": "Cache-Control"
          }
        ],
        "source": "/api/**"
      }
    ],
    "rewrites": [
      {
        "source": "/api/contact",
        "function": {
          "functionId": "contact",
          "region": "us-central1"
        }
      }
    ]
  },
  "functions": [
    {
      "runtime": "nodejs22",
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run check"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        ".env*",
        "test",
        "coverage"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "singleProjectMode": true,
    "ui": {
      "enabled": true
    }
  }
}